<%- include('partials/header.ejs') %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link rel="stylesheet" href="/stylesheet/productList.css">

<%
    // Keep the active filters when moving between pages
    const pageUrl = (p) => '?' + new URLSearchParams({
        page: p,
        search: search || '',
        sort: sort || '',
        category: category || 'all'
    }).toString();
%>

<!-- Top bar -->
<header class="pl-nav">
    <div class="pl-nav__inner">
        <a class="pl-nav__logo" href="/user/">
            <img src="/image/Shoppycartfinel.png" alt="ShoppyCart">
        </a>

        <ul class="pl-nav__links">
            <li><a href="/user/">Home</a></li>
            <li class="is-active"><a href="/user/productList">Shop</a></li>
        </ul>

        <div class="pl-nav__actions">
            <a href="/user/profile" aria-label="Profile"><i class="fas fa-user"></i></a>
            <a href="/user/wishlist" aria-label="Wishlist"><i class="fas fa-heart"></i></a>
            <a href="/user/cart" aria-label="Cart"><i class="fas fa-shopping-cart"></i></a>
            <a href="/user/wallet" aria-label="Wallet"><i class="fas fa-wallet"></i></a>
            <a href="/user/logout" aria-label="Log out"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </div>
</header>

<main class="pl-page">
    <nav class="pl-crumbs" aria-label="Breadcrumb">
        <a href="/user/">Home</a><span>/</span>Shop
    </nav>

    <div class="pl-head">
        <h1 class="pl-title">Shop</h1>
    </div>

    <div class="pl-layout">

        <!-- Filters -->
        <aside class="pl-filters">
            <form id="filter-form" action="/user/productList" method="get">

                <div class="pl-search">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input type="search" id="search" name="search" class="pl-input"
                           placeholder="Search products" aria-label="Search products"
                           value="<%= search || '' %>">
                </div>

                <details class="pl-group" open>
                    <summary>Category</summary>
                    <div class="pl-opts">
                        <label class="pl-opt">
                            <input type="radio" name="category" value="all" <%= (!category || category === 'all') ? 'checked' : '' %>>
                            <span class="pl-opt__mark"></span>
                            <span class="pl-opt__label">All</span>
                        </label>
                        <% categories.forEach(cat => { %>
                            <label class="pl-opt">
                                <input type="radio" name="category" value="<%= cat._id %>" <%= String(cat._id) === String(category) ? 'checked' : '' %>>
                                <span class="pl-opt__mark"></span>
                                <span class="pl-opt__label"><%= cat.name %></span>
                            </label>
                        <% }); %>
                    </div>
                </details>

                <details class="pl-group" open>
                    <summary>Sort by</summary>
                    <div class="pl-opts">
                        <% [
                            ['', 'Default'],
                            ['popularity', 'Popularity'],
                            ['price-low-high', 'Price: low to high'],
                            ['price-high-low', 'Price: high to low'],
                            ['average-ratings', 'Average rating'],
                            ['featured', 'Featured'],
                            ['new-arrivals', 'New arrivals'],
                            ['a-z', 'Name: A to Z'],
                            ['z-a', 'Name: Z to A']
                        ].forEach(([value, label]) => { %>
                            <label class="pl-opt">
                                <input type="radio" name="sort" value="<%= value %>" <%= (sort || '') === value ? 'checked' : '' %>>
                                <span class="pl-opt__mark"></span>
                                <span class="pl-opt__label"><%= label %></span>
                            </label>
                        <% }); %>
                    </div>
                </details>

                <% if (search || sort || (category && category !== 'all')) { %>
                    <a href="/user/productList" class="pl-link pl-clear">Clear all filters</a>
                <% } %>
            </form>
        </aside>

        <!-- Products -->
        <section>
            <div class="pl-grid" id="product-grid">
                <% if (!products.length) { %>
                    <div class="pl-empty">
                        <h3>No products found</h3>
                        <p>Try a different search or remove a filter.</p>
                        <a href="/user/productList" class="pl-btn" style="display:inline-grid;place-items:center;text-decoration:none;">Clear filters</a>
                    </div>
                <% } %>

                <% products.forEach(function (item) {
                    const inStock = item.stock > 0;
                    const off = item.hasDiscount
                        ? Math.round((1 - item.discountedPrice / item.price) * 100)
                        : 0;
                %>
                    <article class="pl-card <%= inStock ? '' : 'is-sold' %>">
                        <div class="pl-card__media">
                            <a href="/user/productDetails/<%= item._id %>" aria-label="<%= item.product %>">
                                <img src="/uploads/<%= item.images[0] %>" alt="<%= item.product %>" loading="lazy">
                            </a>

                            <button type="button" class="pl-wish" data-wishlist="<%= item._id %>" aria-label="Add to wishlist">
                                <i class="fa fa-heart"></i>
                            </button>

                            <% if (!inStock) { %>
                                <span class="pl-tag">Sold out</span>
                            <% } %>
                        </div>

                        <div class="pl-card__body">
                            <% if (item.brand) { %><p class="pl-card__brand"><%= item.brand %></p><% } %>
                            <a href="/user/productDetails/<%= item._id %>" class="pl-card__name"><%= item.product %></a>

                            <div class="pl-price">
                                <% if (item.hasDiscount) { %>
                                    <span class="pl-price__now">₹<%= item.discountedPrice.toFixed(2) %></span>
                                    <span class="pl-price__was">₹<%= item.price.toFixed(2) %></span>
                                    <span class="pl-price__off"><%= off %>% off</span>
                                <% } else { %>
                                    <span class="pl-price__now">₹<%= item.price.toFixed(2) %></span>
                                <% } %>
                            </div>

                            <button type="button" class="pl-add" data-cart="<%= item._id %>" <%= inStock ? '' : 'disabled' %>>
                                <%= inStock ? 'Add to cart' : 'Sold out' %>
                            </button>
                        </div>
                    </article>
                <% }); %>
            </div>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
            <nav aria-label="Product pages">
                <ul class="pl-pages">
                    <% if (currentPage > 1) { %>
                        <li><a href="<%= pageUrl(currentPage - 1) %>">Previous</a></li>
                    <% } %>
                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <li class="<%= currentPage === i ? 'is-current' : '' %>">
                            <a href="<%= pageUrl(i) %>" <%= currentPage === i ? 'aria-current="page"' : '' %>><%= i %></a>
                        </li>
                    <% } %>
                    <% if (currentPage < totalPages) { %>
                        <li><a href="<%= pageUrl(currentPage + 1) %>">Next</a></li>
                    <% } %>
                </ul>
            </nav>
            <% } %>
        </section>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const toast = Swal.mixin({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 1800,
        timerProgressBar: true
    });

    async function postAction(url, failMessage) {
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin'
            });
            const data = await res.json();
            toast.fire({
                icon: data.success ? 'success' : 'error',
                title: data.message || (data.success ? 'Done' : failMessage)
            });
        } catch (err) {
            console.error(err);
            toast.fire({ icon: 'error', title: failMessage });
        }
    }

    // Add to cart / wishlist
    document.addEventListener('click', (e) => {
        const cartBtn = e.target.closest('[data-cart]');
        if (cartBtn) {
            postAction(`/user/cart/addProducts/${cartBtn.dataset.cart}`, 'Could not add to cart');
            return;
        }
        const wishBtn = e.target.closest('[data-wishlist]');
        if (wishBtn) {
            postAction(`/user/addToWishlist/${wishBtn.dataset.wishlist}`, 'Could not add to wishlist');
        }
    });

    // Apply instantly when a category or sort option is picked (search submits on Enter)
    document.querySelectorAll('#filter-form input[type="radio"]').forEach((el) => {
        el.addEventListener('change', () => document.getElementById('filter-form').submit());
    });
</script>

<%- include('./partials/footer.ejs') %>
