<%- include('partials/header.ejs') %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link rel="stylesheet" href="/stylesheet/wishlist.css">

<%
    const items = (typeof wishlist !== 'undefined' && wishlist) ? wishlist : [];
%>

<!-- Top bar -->
<header class="pl-nav">
    <div class="pl-nav__inner">
        <a class="pl-nav__logo" href="/user/">
            <img src="/image/Shoppycartfinel.png" alt="ShoppyCart">
        </a>

        <ul class="pl-nav__links">
            <li><a href="/user/">Home</a></li>
            <li><a href="/user/productList">Shop</a></li>
        </ul>

        <div class="pl-nav__actions">
            <a href="/user/profile" aria-label="Profile"><i class="fas fa-user"></i></a>
            <a href="/user/wishlist" class="is-active" aria-label="Wishlist" aria-current="page"><i class="fas fa-heart"></i></a>
            <a href="/user/cart" aria-label="Cart"><i class="fas fa-shopping-cart"></i></a>
            <a href="/user/wallet" aria-label="Wallet"><i class="fas fa-wallet"></i></a>
            <a href="/user/logout" aria-label="Log out"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </div>
</header>

<main class="ws-page">
    <div class="ws-head">
        <h1 class="ws-title">Wishlist</h1>
        <% if (items.length) { %>
            <span class="ws-count"><%= items.length %> <%= items.length === 1 ? 'item' : 'items' %></span>
        <% } %>
    </div>

    <% if (items.length) { %>
        <div class="ws-grid" id="wishlistGrid">
            <% items.forEach((item) => { %>
                <article class="ws-card" id="wishlist-row-<%= item.productId._id %>">
                    <div class="ws-card__media">
                        <a href="/user/productDetails/<%= item.productId._id %>" aria-label="<%= item.name %>">
                            <img src="/uploads/<%= item.image %>" alt="<%= item.name %>" loading="lazy">
                        </a>
                        <button type="button" class="ws-remove" data-remove="<%= item.productId._id %>" aria-label="Remove <%= item.name %> from wishlist">
                            <i class="fa fa-times"></i>
                        </button>
                    </div>

                    <div class="ws-card__body">
                        <a href="/user/productDetails/<%= item.productId._id %>" class="ws-card__name"><%= item.name %></a>
                        <div class="ws-card__price" id="price-<%= item.productId._id %>">₹<%= Number(item.price).toFixed(2) %></div>

                        <button type="button" class="ws-btn ws-btn--ghost ws-add" data-cart="<%= item.productId._id %>">Add to cart</button>
                    </div>
                </article>
            <% }); %>
        </div>

        <div class="ws-foot">
            <a class="ws-link" href="/user/productList">Continue shopping</a>
        </div>
    <% } else { %>
        <div class="ws-empty">
            <h2>Your wishlist is empty</h2>
            <p>Tap the heart on any product to save it here.</p>
            <a href="/user/productList" class="ws-btn">Continue shopping</a>
        </div>
    <% } %>
</main>

<%- include('partials/footer.ejs') %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const confirmSwal = Swal.mixin({
        buttonsStyling: false,
        reverseButtons: true,
        customClass: {
            popup: 'ws-swal',
            confirmButton: 'ws-btn',
            cancelButton: 'ws-btn ws-btn--ghost'
        }
    });
    const toast = Swal.mixin({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 1500,
        timerProgressBar: true,
        customClass: { popup: 'ws-swal' }
    });

    // Remove from wishlist
    async function removeItem(productId) {
        const result = await confirmSwal.fire({
            icon: 'warning',
            title: 'Remove this product?',
            text: 'It will be removed from your wishlist.',
            showCancelButton: true,
            confirmButtonText: 'Yes, remove it',
            cancelButtonText: 'Keep it'
        });
        if (!result.isConfirmed) return;

        try {
            const response = await fetch(`/user/removeWishlist/${productId}`, {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin'
            });
            const data = await response.json();

            if (data.success) {
                document.getElementById(`wishlist-row-${productId}`).remove();
                toast.fire({ icon: 'success', title: data.message || 'Removed from wishlist' });
                // Reload to refresh the count, or show the empty state when nothing is left
                setTimeout(() => window.location.reload(), 900);
            } else {
                toast.fire({ icon: 'error', title: data.message || 'Could not remove the product' });
            }
        } catch (error) {
            console.error('Error:', error);
            toast.fire({ icon: 'error', title: 'Something went wrong' });
        }
    }

    // Add to cart
    async function addToCart(productId) {
        try {
            const response = await fetch(`/user/cart/addProducts/${productId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin'
            });
            const data = await response.json();

            if (data.success) {
                toast.fire({ icon: 'success', title: data.message || 'Added to cart' });
                setTimeout(() => window.location.reload(), 900);
            } else {
                toast.fire({ icon: 'error', title: data.message || 'Could not add to cart' });
            }
        } catch (error) {
            console.error('Error:', error);
            toast.fire({ icon: 'error', title: 'Something went wrong' });
        }
    }

    document.addEventListener('click', (e) => {
        const removeBtn = e.target.closest('[data-remove]');
        if (removeBtn) { removeItem(removeBtn.dataset.remove); return; }

        const cartBtn = e.target.closest('[data-cart]');
        if (cartBtn) addToCart(cartBtn.dataset.cart);
    });
</script>
</body>
</html>
