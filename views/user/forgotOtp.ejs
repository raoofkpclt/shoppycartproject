<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Verify code · ShoppyCart</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap');

        :root {
            --pl-bg: #ffffff;
            --pl-tile: #f4f4f2;
            --pl-ink: #151517;
            --pl-muted: #74777d;
            --pl-line: #e7e7e9;
            --pl-sale: #1f6b45;
            --pl-danger: #c2373d;
            --pl-radius: 6px;
            --pl-font: 'Manrope', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 32px 16px;
            font-family: var(--pl-font);
            color: var(--pl-ink);
            background: var(--pl-tile);
            -webkit-font-smoothing: antialiased;
        }

        .lg-card { width: 100%; max-width: 420px; padding: 40px; background: var(--pl-bg); border-radius: 10px; }
        .lg-logo { display: block; margin-bottom: 32px; }
        .lg-logo img { height: 28px; width: auto; display: block; }
        .lg-title { margin: 0 0 8px; font-size: 28px; font-weight: 600; letter-spacing: -0.02em; }
        .lg-lead { margin: 0 0 28px; font-size: 15px; line-height: 1.6; color: var(--pl-muted); }
        .lg-lead strong { color: var(--pl-ink); font-weight: 600; word-break: break-all; }

        .lg-notice { margin: 0 0 20px; padding: 12px 14px; font-size: 14px; line-height: 1.5; border-radius: var(--pl-radius); }
        .lg-notice--ok { color: var(--pl-sale); background: #e9f3ed; }
        .lg-notice--error { color: var(--pl-danger); background: #fbeaeb; }
        .lg-notice[hidden] { display: none; }

        .lg-field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 20px; }
        .lg-field label { font-size: 13px; font-weight: 500; color: var(--pl-muted); }
        .lg-field input {
            height: 56px; padding: 0 14px;
            font: inherit; font-size: 22px; font-weight: 600; letter-spacing: .3em; text-align: center;
            font-variant-numeric: tabular-nums; color: var(--pl-ink);
            background: #fff; border: 1px solid var(--pl-line); border-radius: var(--pl-radius);
            transition: border-color .2s;
        }
        .lg-field input:focus { outline: none; border-color: var(--pl-ink); }

        .lg-btn {
            display: flex; align-items: center; justify-content: center;
            width: 100%; height: 52px; padding: 0 24px;
            font: inherit; font-size: 15px; font-weight: 600;
            color: #fff; background: var(--pl-ink);
            border: 1px solid var(--pl-ink); border-radius: var(--pl-radius);
            cursor: pointer; transition: background .2s;
        }
        .lg-btn:hover { background: #2c2c30; }

        .lg-resend { margin: 24px 0 0; font-size: 14px; text-align: center; color: var(--pl-muted); }
        .lg-textbtn {
            padding: 0; font: inherit; font-size: 14px; font-weight: 600;
            color: var(--pl-ink); background: none; border: 0;
            text-decoration: underline; text-underline-offset: 3px; cursor: pointer;
        }
        .lg-textbtn:disabled { display: none; }

        a:focus-visible, button:focus-visible, input:focus-visible { outline: 2px solid var(--pl-ink); outline-offset: 3px; }

        @media (max-width: 480px) { .lg-card { padding: 28px 20px; } .lg-title { font-size: 24px; } }
        @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
    </style>
</head>
<body>
    <main class="lg-card">
        <a class="lg-logo" href="/user/"><img src="/image/Shoppycartfinel.png" alt="ShoppyCart"></a>

        <h1 class="lg-title">Enter your code</h1>
        <p class="lg-lead">
            Enter the code we sent to
            <strong><%= typeof email !== 'undefined' ? email : 'your email' %></strong>.
        </p>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="lg-notice lg-notice--error" role="alert"><%= error %></div>
        <% } %>
        <div class="lg-notice" id="status" role="status" hidden></div>

        <form action="/user/verifyotp" method="POST">
            <input type="hidden" id="email" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>">

            <div class="lg-field">
                <label for="otp">Verification code</label>
                <input name="otp" id="otp" type="text" inputmode="numeric" autocomplete="one-time-code" required autofocus>
            </div>

            <button type="submit" class="lg-btn">Verify</button>
        </form>

        <p class="lg-resend">
            <span id="timerDisplay"></span>
            <button type="button" id="resendOTPBtn" class="lg-textbtn" disabled>Resend code</button>
        </p>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const RESEND_SECONDS = 60;
            const KEY = 'otpEndTime';
            const timerDisplay = document.getElementById('timerDisplay');
            const resendButton = document.getElementById('resendOTPBtn');
            const status = document.getElementById('status');
            const email = document.getElementById('email').value;
            let timer = null;

            function showStatus(text, ok) {
                status.textContent = text;
                status.className = 'lg-notice ' + (ok ? 'lg-notice--ok' : 'lg-notice--error');
                status.hidden = false;
            }

            // Store an end time so the countdown survives a page reload
            function startCountdown(fresh) {
                let end = parseInt(localStorage.getItem(KEY), 10);
                if (fresh || !end || end <= Date.now()) {
                    end = Date.now() + RESEND_SECONDS * 1000;
                    localStorage.setItem(KEY, end);
                }
                clearInterval(timer);
                resendButton.disabled = true;

                const tick = () => {
                    const left = Math.max(0, Math.ceil((end - Date.now()) / 1000));
                    if (left <= 0) {
                        clearInterval(timer);
                        localStorage.removeItem(KEY);
                        timerDisplay.textContent = "Didn't get a code?";
                        resendButton.disabled = false;
                        return;
                    }
                    const m = Math.floor(left / 60);
                    const s = String(left % 60).padStart(2, '0');
                    timerDisplay.textContent = `You can request a new code in ${m}:${s}`;
                };
                tick();
                timer = setInterval(tick, 1000);
            }

            startCountdown(false);

            resendButton.addEventListener('click', async () => {
                resendButton.disabled = true;
                try {
                    const response = await fetch('/user/resendOtp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email })
                    });
                    const data = await response.json();
                    if (data.success) {
                        showStatus(data.message || 'A new code has been sent.', true);
                        startCountdown(true);
                    } else {
                        showStatus(data.message || 'Could not send a new code.', false);
                        resendButton.disabled = false;
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showStatus('Could not send a new code. Please try again.', false);
                    resendButton.disabled = false;
                }
            });
        });
    </script>
</body>
</html>
