<%- include('partials/header.ejs') %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link rel="stylesheet" href="/stylesheet/productDetails.css">

<%
    // Edit these lists to change the options shown (they are not sent to the cart yet)
    const sizes  = ['S', 'L', 'XL', 'XXL'];
    const colors = [
        { name: 'Black', hex: '#151517' },
        { name: 'Navy',  hex: '#20315f' },
        { name: 'Grey',  hex: '#8a8f98' },
        { name: 'Green', hex: '#1f6b45' },
        { name: 'Tan',   hex: '#c2a27a' }
    ];

    const inStock = product.stock > 0;
    const stockClass = product.stock === 0 ? 'is-out' : (product.stock === 1 ? 'is-low' : '');
    const stockText = product.stock === 0
        ? 'Sold out'
        : (product.stock === 1 ? 'Only 1 left' : product.stock + ' in stock');
    const categoryName = product.categoryId && product.categoryId.name ? product.categoryId.name : '';
%>

<!-- Top bar -->
<header class="pl-nav">
    <div class="pl-nav__inner">
        <a class="pl-nav__logo" href="/user/">
            <img src="/image/Shoppycartfinel.png" alt="ShoppyCart">
        </a>

        <ul class="pl-nav__links">
            <li><a href="/user/">Home</a></li>
            <li class="is-active"><a href="/user/productList">Shop</a></li>
        </ul>

        <div class="pl-nav__actions">
            <a href="/user/profile" aria-label="Profile"><i class="fas fa-user"></i></a>
            <a href="/user/wishlist" aria-label="Wishlist"><i class="fas fa-heart"></i></a>
            <a href="/user/cart" aria-label="Cart"><i class="fas fa-shopping-cart"></i></a>
            <a href="/user/wallet" aria-label="Wallet"><i class="fas fa-wallet"></i></a>
            <a href="/user/logout" aria-label="Log out"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </div>
</header>

<main>
    <div class="pd-page">
        <nav class="pd-crumbs" aria-label="Breadcrumb">
            <a href="/user/">Home</a><span>/</span><a href="/user/productList">Shop</a><span>/</span><%= product.product %>
        </nav>

        <div class="pd-layout">

            <!-- Gallery -->
            <div class="pd-gallery">
                <div class="pd-thumbs">
                    <% product.images.forEach((image, index) => { %>
                        <button type="button" class="pd-thumb <%= index === 0 ? 'is-active' : '' %>"
                                data-image="/uploads/<%= image %>" aria-label="Show image <%= index + 1 %>">
                            <img src="/uploads/<%= image %>" alt="" loading="lazy">
                        </button>
                    <% }); %>
                </div>

                <div class="pd-main" id="pdMain">
                    <img id="mainImage" src="/uploads/<%= product.images[0] %>" alt="<%= product.product %>">
                </div>
            </div>

            <!-- Info -->
            <div class="pd-info">
                <% if (categoryName) { %><p class="pd-cat"><%= categoryName %></p><% } %>
                <h1 class="pd-title"><%= product.product %></h1>
                <% if (product.brand) { %><p class="pd-brand"><%= product.brand %></p><% } %>

                <div class="pd-price">
                    <% if (product.hasDiscount) { %>
                        <span class="pd-price__now">₹<%= product.discountedPrice.toFixed(2) %></span>
                        <span class="pd-price__was">₹<%= product.price.toFixed(2) %></span>
                        <span class="pd-price__off"><%= product.discountPercentage %>% off</span>
                    <% } else { %>
                        <span class="pd-price__now">₹<%= product.price.toFixed(2) %></span>
                    <% } %>
                </div>

                <div class="pd-meta">
                    <p class="pd-stock <%= stockClass %>"><%= stockText %></p>
                    <div class="pd-rating" aria-label="Rated 4.3 out of 5">
                        <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star-half-alt"></i>
                        <span>4.3</span>
                    </div>
                </div>

                <div class="pd-opt">
                    <p class="pd-opt__label">Size</p>
                    <div class="pd-opt__row">
                        <% sizes.forEach((size, i) => { %>
                            <label class="pd-chip">
                                <input type="radio" name="size" value="<%= size %>" <%= i === 0 ? 'checked' : '' %>>
                                <span><%= size %></span>
                            </label>
                        <% }); %>
                    </div>
                </div>

                <div class="pd-opt">
                    <p class="pd-opt__label">Colour</p>
                    <div class="pd-opt__row">
                        <% colors.forEach((c, i) => { %>
                            <label class="pd-swatch" title="<%= c.name %>">
                                <input type="radio" name="color" value="<%= c.name %>" aria-label="<%= c.name %>" <%= i === 0 ? 'checked' : '' %>>
                                <span style="--c: <%= c.hex %>;"></span>
                            </label>
                        <% }); %>
                    </div>
                </div>

                <div class="pd-actions">
                    <% if (inStock) { %>
                        <button type="button" class="pd-add" data-cart="<%= product._id %>">Add to cart</button>
                    <% } else { %>
                        <button type="button" class="pd-add" disabled>Sold out</button>
                    <% } %>
                    <button type="button" class="pd-wish" data-wishlist="<%= product._id %>" aria-label="Add to wishlist">
                        <i class="fa fa-heart"></i>
                    </button>
                </div>

                <% if (product.description) { %>
                    <div class="pd-desc">
                        <h2>Description</h2>
                        <p><%= product.description %></p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Related products -->
    <% if (relatedProducts && relatedProducts.length) { %>
    <section class="pd-related">
        <h2>Related products</h2>
        <div class="pl-grid">
            <% relatedProducts.forEach(function (item) {
                const price = item.discountPrice || item.price;
            %>
                <a class="pl-card" href="/user/productDetails/<%= item._id %>">
                    <div class="pl-card__media">
                        <img src="/uploads/<%= item.images[0] %>" alt="<%= item.product %>" loading="lazy">
                    </div>
                    <div class="pl-card__body">
                        <% if (item.brand) { %><p class="pl-card__brand"><%= item.brand %></p><% } %>
                        <h3 class="pl-card__name"><%= item.product %></h3>
                        <div class="pl-price">₹<%= price %></div>
                    </div>
                </a>
            <% }); %>
        </div>
    </section>
    <% } %>
</main>

<%- include('partials/footer.ejs') %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Gallery: switch main image
    (function () {
        const main = document.getElementById('mainImage');
        const thumbs = document.querySelectorAll('.pd-thumb');
        thumbs.forEach((thumb) => {
            thumb.addEventListener('click', () => {
                main.src = thumb.dataset.image;
                thumbs.forEach((t) => t.classList.remove('is-active'));
                thumb.classList.add('is-active');
            });
        });

        // Hover zoom (mouse only)
        const frame = document.getElementById('pdMain');
        if (!window.matchMedia('(hover: hover)').matches) return;
        frame.addEventListener('mouseenter', () => frame.classList.add('is-zoomed'));
        frame.addEventListener('mouseleave', () => frame.classList.remove('is-zoomed'));
        frame.addEventListener('mousemove', (e) => {
            const r = frame.getBoundingClientRect();
            const x = ((e.clientX - r.left) / r.width) * 100;
            const y = ((e.clientY - r.top) / r.height) * 100;
            main.style.transformOrigin = x + '% ' + y + '%';
        });
    })();

    // Cart / wishlist
    const toast = Swal.mixin({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 1800,
        timerProgressBar: true
    });

    async function postAction(url, failMessage) {
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin'
            });
            const data = await res.json();
            toast.fire({
                icon: data.success ? 'success' : 'error',
                title: data.message || (data.success ? 'Done' : failMessage)
            });
        } catch (err) {
            console.error(err);
            toast.fire({ icon: 'error', title: failMessage });
        }
    }

    document.addEventListener('click', (e) => {
        const cartBtn = e.target.closest('[data-cart]');
        if (cartBtn) {
            postAction('/user/cart/addProducts/' + cartBtn.dataset.cart, 'Could not add to cart');
            return;
        }
        const wishBtn = e.target.closest('[data-wishlist]');
        if (wishBtn) {
            postAction('/user/addToWishlist/' + wishBtn.dataset.wishlist, 'Could not add to wishlist');
        }
    });
</script>
</body>
</html>
