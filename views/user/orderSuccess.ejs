<%- include('partials/header.ejs') %>

<style>
@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap');

:root {
    --pl-bg: #ffffff;
    --pl-tile: #f4f4f2;
    --pl-ink: #151517;
    --pl-muted: #74777d;
    --pl-line: #e7e7e9;
    --pl-sale: #1f6b45;
    --pl-radius: 6px;
    --pl-font: 'Manrope', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --pl-max: 1240px;
}

body { font-family: var(--pl-font); color: var(--pl-ink); background: var(--pl-bg); -webkit-font-smoothing: antialiased; }

/* ---------- Top bar ---------- */
.pl-nav { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--pl-line); }
.pl-nav__inner { max-width: var(--pl-max); margin: 0 auto; padding: 0 24px; height: 68px; display: flex; align-items: center; }
.pl-nav__logo img { height: 28px; width: auto; display: block; }

/* ---------- Confirmation ---------- */
.os-page { max-width: 560px; margin: 0 auto; padding: 96px 24px 120px; text-align: center; }

.os-mark { width: 72px; height: 72px; margin: 0 auto 32px; color: var(--pl-sale); }
.os-mark circle { fill: none; stroke: currentColor; stroke-width: 2; opacity: .25; }
.os-mark path { fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 40; stroke-dashoffset: 40; animation: os-draw .6s .15s ease-out forwards; }
@keyframes os-draw { to { stroke-dashoffset: 0; } }

.os-title { margin: 0 0 12px; font-size: 32px; font-weight: 600; letter-spacing: -0.02em; }
.os-lead { margin: 0 auto 40px; max-width: 420px; font-size: 15px; line-height: 1.65; color: var(--pl-muted); }

.os-card { margin-bottom: 40px; padding: 28px 32px; background: var(--pl-tile); border-radius: 10px; text-align: left; }
.os-card dl { margin: 0; }
.os-card div { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 8px 0; font-size: 15px; }
.os-card dt { color: var(--pl-muted); }
.os-card dd { margin: 0; font-weight: 600; word-break: break-all; text-align: right; font-variant-numeric: tabular-nums; }
.os-card .os-card__note { display: block; margin-top: 12px; padding-top: 16px; border-top: 1px solid #deded9; font-size: 13px; line-height: 1.6; color: var(--pl-muted); }

.os-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
.os-btn { display: inline-flex; align-items: center; justify-content: center; height: 52px; padding: 0 28px; font: inherit; font-size: 15px; font-weight: 600; text-decoration: none; color: #fff; background: var(--pl-ink); border: 1px solid var(--pl-ink); border-radius: var(--pl-radius); cursor: pointer; transition: background .2s, border-color .2s; }
.os-btn:hover { background: #2c2c30; color: #fff; }
.os-btn--ghost { background: transparent; color: var(--pl-ink); border-color: var(--pl-line); }
.os-btn--ghost:hover { background: transparent; color: var(--pl-ink); border-color: var(--pl-ink); }

.os-page a:focus-visible, .pl-nav a:focus-visible { outline: 2px solid var(--pl-ink); outline-offset: 3px; }

@media (max-width: 640px) {
    .os-page { padding: 64px 16px 80px; }
    .os-title { font-size: 26px; }
    .os-card { padding: 20px; }
    .os-actions .os-btn { width: 100%; }
}
@media (prefers-reduced-motion: reduce) {
    .os-mark path { animation: none; stroke-dashoffset: 0; }
    * { transition: none !important; }
}
</style>

<header class="pl-nav">
    <div class="pl-nav__inner">
        <a class="pl-nav__logo" href="/user/"><img src="/image/Shoppycartfinel.png" alt="ShoppyCart"></a>
    </div>
</header>

<main class="os-page">
    <svg class="os-mark" viewBox="0 0 72 72" aria-hidden="true">
        <circle cx="36" cy="36" r="34"></circle>
        <path d="M22 37l10 10 18-21"></path>
    </svg>

    <h1 class="os-title">Thank you for your order</h1>
    <p class="os-lead">Your order is confirmed. We'll email you the details shortly.</p>

    <div class="os-card">
        <dl>
            <div><dt>Order number</dt><dd><%= orderId %></dd></div>
            <div><dt>Status</dt><dd>Confirmed</dd></div>
        </dl>
        <span class="os-card__note">Keep this number handy if you need to contact support.</span>
    </div>

    <div class="os-actions">
        <a href="/user/productList" class="os-btn">Continue shopping</a>
        <a href="/user/" class="os-btn os-btn--ghost">Back to home</a>
    </div>
</main>

<%- include('partials/footer.ejs') %>
</body>
</html>
