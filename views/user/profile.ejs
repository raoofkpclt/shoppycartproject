<%- include('partials/header.ejs') %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link rel="stylesheet" href="/stylesheet/profile.css">

<%
    const fa = (typeof firstAddress !== 'undefined' && firstAddress) ? firstAddress : {};
    const initial = (user.name || '?').trim().charAt(0).toUpperCase();
    const statusLabels = {
        pending: 'Pending',
        shipped: 'Shipped',
        delivered: 'Delivered',
        cancelled: 'Cancelled',
        returnRequested: 'Return requested',
        returned: 'Returned'
    };
    const fmtDate = (d) => new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
%>

<!-- Top bar -->
<header class="pl-nav">
    <div class="pl-nav__inner">
        <a class="pl-nav__logo" href="/user/">
            <img src="/image/Shoppycartfinel.png" alt="ShoppyCart">
        </a>

        <ul class="pl-nav__links">
            <li><a href="/user/">Home</a></li>
            <li><a href="/user/productList">Shop</a></li>
        </ul>

        <div class="pl-nav__actions">
            <a href="/user/profile" class="is-active" aria-label="Profile" aria-current="page"><i class="fas fa-user"></i></a>
            <a href="/user/wishlist" aria-label="Wishlist"><i class="fas fa-heart"></i></a>
            <a href="/user/cart" aria-label="Cart"><i class="fas fa-shopping-cart"></i></a>
            <a href="/user/wallet" aria-label="Wallet"><i class="fas fa-wallet"></i></a>
            <a href="/user/logout" aria-label="Log out"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </div>
</header>

<main class="pf-page">
    <div class="pf-head">
        <h1 class="pf-title">My account</h1>
    </div>

    <div class="pf-layout">

        <!-- Sidebar -->
        <aside class="pf-side">
            <div class="pf-user">
                <div class="pf-avatar" aria-hidden="true"><%= initial %></div>
                <div>
                    <p class="pf-user__name"><%= user.name %></p>
                    <p class="pf-user__email"><%= user.email %></p>
                </div>
            </div>

            <nav class="pf-tabs" aria-label="Account">
                <button type="button" class="pf-tab is-active" data-action="tab" data-tab="profile">Profile</button>
                <button type="button" class="pf-tab" data-action="tab" data-tab="orders">Orders</button>
                <button type="button" class="pf-tab" data-action="tab" data-tab="addresses">Addresses</button>
                <a href="/user/logout" class="pf-tab pf-tab--out">Log out</a>
            </nav>
        </aside>

        <!-- Content -->
        <div>

            <!-- Profile -->
            <section class="pf-panel" id="panel-profile">
                <div class="pf-panel__head">
                    <h2>Profile</h2>
                    <button type="button" class="pf-btn pf-btn--ghost pf-btn--sm" data-action="edit-profile" id="editProfileBtn">Edit profile</button>
                </div>

                <dl class="pf-rows" id="profileView">
                    <div><dt>Name</dt><dd><%= user.name %></dd></div>
                    <div><dt>Email</dt><dd><%= user.email %></dd></div>
                    <div><dt>Contact</dt><dd><%= fa.phone || 'Not provided' %></dd></div>
                    <div><dt>City</dt><dd><%= fa.city || 'Not provided' %></dd></div>
                    <div><dt>State</dt><dd><%= fa.state || 'Not provided' %></dd></div>
                    <div>
                        <dt>Referral code</dt>
                        <dd>
                            <span class="pf-code">
                                <code id="referralCode"><%= user.referralCode %></code>
                                <button type="button" class="pf-btn pf-btn--ghost pf-btn--sm" data-action="copy-referral">
                                    <i class="fas fa-copy"></i> Copy
                                </button>
                            </span>
                        </dd>
                    </div>
                </dl>

                <form id="editProfileForm" class="pf-form" action="/user/editProfile" method="POST" hidden>
                    <div class="pf-grid2">
                        <div class="pf-field">
                            <label for="pf-name">Name</label>
                            <input type="text" id="pf-name" name="name" value="<%= user.name %>" required>
                        </div>
                        <div class="pf-field">
                            <label for="pf-email">Email</label>
                            <input type="email" id="pf-email" name="email" value="<%= user.email %>" required>
                        </div>
                        <div class="pf-field">
                            <label for="pf-password">New password</label>
                            <input type="password" id="pf-password" name="password" placeholder="Leave blank to keep the same" autocomplete="new-password">
                        </div>
                        <div class="pf-field">
                            <label for="pf-confirm">Confirm password</label>
                            <input type="password" id="pf-confirm" name="confirmPassword" placeholder="Leave blank to keep the same" autocomplete="new-password">
                        </div>
                    </div>
                    <div class="pf-form__actions">
                        <button type="submit" class="pf-btn">Save changes</button>
                        <button type="button" class="pf-btn pf-btn--ghost" data-action="edit-profile">Cancel</button>
                    </div>
                </form>
            </section>

            <!-- Orders -->
            <section class="pf-panel" id="panel-orders" hidden>
                <div class="pf-panel__head"><h2>Orders</h2></div>

                <% if (orders.length > 0) { %>
                    <div class="pf-orders">
                        <% orders.forEach(order => { %>
                            <article class="pf-order">
                                <div class="pf-order__head">
                                    <p class="pf-order__id"><strong>Order</strong><%= order._id %></p>
                                    <span class="pf-status pf-status--<%= order.status %>"><%= statusLabels[order.status] || order.status %></span>
                                </div>

                                <div class="pf-order__body">
                                    <ul class="pf-items">
                                        <% order.products.forEach(product => { %>
                                            <li class="pf-item">
                                                <a class="pf-item__pic" href="/user/productDetails/<%= product.productId._id %>">
                                                    <img src="/uploads/<%= product.productId.images[0] %>" alt="" loading="lazy">
                                                </a>
                                                <a class="pf-item__name" href="/user/productDetails/<%= product.productId._id %>"><%= product.productId.product %></a>
                                                <span class="pf-item__qty">Qty <%= product.quantity %></span>
                                                <span class="pf-item__total">₹<%= product.total %></span>
                                            </li>
                                        <% }) %>
                                    </ul>

                                    <dl class="pf-sum">
                                        <div><dt>Payment</dt><dd><%= order.paymentStatus %></dd></div>
                                        <div><dt>Delivery</dt><dd>₹99</dd></div>
                                        <div><dt>Discount</dt><dd>-₹<%= order.couponDiscount %></dd></div>
                                        <div class="pf-sum__total"><dt>Total</dt><dd>₹<%= order.totalAmount %></dd></div>
                                    </dl>

                                    <div class="pf-order__foot">
                                        <% if (order.status === 'pending' && order.paymentStatus !== 'failed') { %>
                                            <button type="button" class="pf-btn pf-btn--danger pf-btn--sm" data-action="toggle" data-target="cancel-<%= order._id %>">Cancel order</button>
                                        <% } else if (order.status === 'delivered' && order.returnStatus === 'pending') { %>
                                            <button type="button" class="pf-btn pf-btn--ghost pf-btn--sm" data-action="toggle" data-target="return-<%= order._id %>">Return order</button>
                                        <% } %>

                                        <% if (order.paymentStatus === 'failed' && order.paymentMethod !== 'cod') { %>
                                            <button type="button" class="pf-btn pf-btn--sm" data-action="retry-payment" data-order-id="<%= order._id %>">Retry payment</button>
                                        <% } %>

                                        <% if (order.status === 'delivered') { %>
                                            <a href="/user/orders/<%= order._id %>/invoice" class="pf-btn pf-btn--ghost pf-btn--sm" download>
                                                <i class="fas fa-file-invoice"></i> Invoice
                                            </a>
                                        <% } %>

                                        <span class="pf-order__date">Ordered on <%= fmtDate(order.createdAt) %></span>
                                    </div>

                                    <% if (order.status === 'pending' && order.paymentStatus !== 'failed') { %>
                                        <div class="pf-reason" id="cancel-<%= order._id %>" hidden>
                                            <div class="pf-field">
                                                <label for="cancel-reason-<%= order._id %>">Reason for cancelling</label>
                                                <textarea id="cancel-reason-<%= order._id %>" placeholder="Tell us why you are cancelling"></textarea>
                                            </div>
                                            <div class="pf-form__actions">
                                                <button type="button" class="pf-btn pf-btn--danger pf-btn--sm" data-action="cancel-order" data-order-id="<%= order._id %>">Confirm cancellation</button>
                                                <button type="button" class="pf-btn pf-btn--ghost pf-btn--sm" data-action="toggle" data-target="cancel-<%= order._id %>">Close</button>
                                            </div>
                                        </div>
                                    <% } else if (order.status === 'delivered' && order.returnStatus === 'pending') { %>
                                        <div class="pf-reason" id="return-<%= order._id %>" hidden>
                                            <div class="pf-field">
                                                <label for="return-reason-<%= order._id %>">Reason for returning</label>
                                                <textarea id="return-reason-<%= order._id %>" placeholder="Tell us why you are returning this order"></textarea>
                                            </div>
                                            <div class="pf-form__actions">
                                                <button type="button" class="pf-btn pf-btn--sm" data-action="return-order" data-order-id="<%= order._id %>">Confirm return</button>
                                                <button type="button" class="pf-btn pf-btn--ghost pf-btn--sm" data-action="toggle" data-target="return-<%= order._id %>">Close</button>
                                            </div>
                                        </div>
                                    <% } %>
                                </div>
                            </article>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="pf-empty">
                        <h3>No orders yet</h3>
                        <p>When you place an order it will show up here.</p>
                        <a href="/user/productList" class="pf-btn">Start shopping</a>
                    </div>
                <% } %>
            </section>

            <!-- Addresses -->
            <section class="pf-panel" id="panel-addresses" hidden>
                <div class="pf-panel__head">
                    <h2>Addresses</h2>
                    <button type="button" class="pf-btn pf-btn--sm" data-action="open-address">Add address</button>
                </div>

                <% if (addresses && addresses.length > 0) { %>
                    <div class="pf-addrs">
                        <% addresses.forEach((address) => { %>
                            <article class="pf-addr" id="address-<%= address._id %>">
                                <h3><%= address.name %></h3>
                                <p><%= address.address %></p>
                                <p><%= address.locality %>, <%= address.city %></p>
                                <p><%= address.state %> – <%= address.pincode %></p>
                                <% if (address.landmark) { %><p>Landmark: <%= address.landmark %></p><% } %>
                                <p class="pf-addr__phone">
                                    <%= address.phone %><% if (address.alternatePhone) { %> · <%= address.alternatePhone %><% } %>
                                </p>

                                <div class="pf-addr__actions">
                                    <button type="button" class="pf-textbtn" data-action="toggle" data-target="edit-address-<%= address._id %>">Edit</button>
                                    <form action="/user/deleteAddress/<%= address._id %>" method="POST" id="deleteForm<%= address._id %>">
                                        <button type="button" class="pf-textbtn pf-textbtn--danger" data-action="delete-address" data-form="deleteForm<%= address._id %>">Delete</button>
                                    </form>
                                </div>

                                <form class="pf-form" id="edit-address-<%= address._id %>" action="/user/editAddress/<%= address._id %>" method="POST" hidden>
                                    <div class="pf-grid2">
                                        <div class="pf-field"><label>Name</label><input type="text" name="name" value="<%= address.name %>" required></div>
                                        <div class="pf-field"><label>Mobile</label><input type="text" name="phone" value="<%= address.phone %>" required></div>
                                        <div class="pf-field pf-field--wide"><label>Address</label><input type="text" name="address" value="<%= address.address %>" required></div>
                                        <div class="pf-field"><label>Locality</label><input type="text" name="locality" value="<%= address.locality %>" required></div>
                                        <div class="pf-field"><label>City</label><input type="text" name="city" value="<%= address.city %>" required></div>
                                        <div class="pf-field"><label>State</label><input type="text" name="state" value="<%= address.state %>" required></div>
                                        <div class="pf-field"><label>Pin code</label><input type="text" name="pincode" value="<%= address.pincode %>" required></div>
                                        <div class="pf-field"><label>Alternate mobile</label><input type="text" name="alternatePhone" value="<%= address.alternatePhone || '' %>"></div>
                                        <div class="pf-field"><label>Landmark</label><input type="text" name="landmark" value="<%= address.landmark || '' %>"></div>
                                    </div>
                                    <div class="pf-form__actions">
                                        <button type="submit" class="pf-btn pf-btn--sm">Save</button>
                                        <button type="button" class="pf-btn pf-btn--ghost pf-btn--sm" data-action="toggle" data-target="edit-address-<%= address._id %>">Cancel</button>
                                    </div>
                                </form>
                            </article>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="pf-empty">
                        <h3>No addresses yet</h3>
                        <p>Add an address to speed up checkout.</p>
                        <button type="button" class="pf-btn" data-action="open-address">Add address</button>
                    </div>
                <% } %>
            </section>
        </div>
    </div>
</main>

<!-- Add address dialog -->
<dialog class="pf-dialog" id="addAddressDialog" aria-labelledby="addAddressTitle">
    <h2 id="addAddressTitle">Add address</h2>
    <form id="addAddressForm" method="post" action="/user/addAddress">
        <div class="pf-grid2">
            <div class="pf-field">
                <label for="add-name">Name</label>
                <input type="text" id="add-name" name="name" required>
            </div>
            <div class="pf-field">
                <label for="add-mobile">Mobile number</label>
                <input type="tel" id="add-mobile" name="phone" required pattern="[0-9]{10}" title="10 digit mobile number">
            </div>
            <div class="pf-field pf-field--wide">
                <label for="add-address">Address</label>
                <textarea id="add-address" name="address" required></textarea>
            </div>
            <div class="pf-field">
                <label for="add-locality">Locality</label>
                <input type="text" id="add-locality" name="locality" required>
            </div>
            <div class="pf-field">
                <label for="add-city">City / District / Town</label>
                <input type="text" id="add-city" name="city" required>
            </div>
            <div class="pf-field">
                <label for="add-state">State</label>
                <input type="text" id="add-state" name="state" required>
            </div>
            <div class="pf-field">
                <label for="add-pincode">Pin code</label>
                <input type="text" id="add-pincode" name="pincode" required>
            </div>
            <div class="pf-field">
                <label for="add-landmark">Landmark (optional)</label>
                <input type="text" id="add-landmark" name="landmark">
            </div>
            <div class="pf-field">
                <label for="add-alt">Alternate phone (optional)</label>
                <input type="tel" id="add-alt" name="alternatePhone" pattern="[0-9]{10}" title="10 digit mobile number">
            </div>
        </div>
        <div class="pf-form__actions">
            <button type="submit" class="pf-btn">Save address</button>
            <button type="button" class="pf-btn pf-btn--ghost" data-action="close-address">Cancel</button>
        </div>
    </form>
</dialog>

<%- include('./partials/footer.ejs') %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
    // ---------- Alerts ----------
    const confirmSwal = Swal.mixin({
        buttonsStyling: false,
        reverseButtons: true,
        customClass: {
            popup: 'pf-swal',
            confirmButton: 'pf-btn',
            cancelButton: 'pf-btn pf-btn--ghost'
        }
    });
    const toast = Swal.mixin({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 1800,
        timerProgressBar: true,
        customClass: { popup: 'pf-swal' }
    });

    // ---------- Tabs ----------
    const TABS = ['profile', 'orders', 'addresses'];
    const SECTION_ALIASES = { addressBook: 'addresses', address: 'addresses' };

    function openTab(name) {
        if (!TABS.includes(name)) name = 'profile';
        TABS.forEach((t) => {
            document.getElementById('panel-' + t).hidden = (t !== name);
        });
        document.querySelectorAll('.pf-tab[data-tab]').forEach((btn) => {
            btn.classList.toggle('is-active', btn.dataset.tab === name);
        });
    }

    // ---------- Helpers ----------
    async function postJson(url, body) {
        const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify(body)
        });
        return res.json();
    }

    async function orderAction(kind, orderId) {
        const isCancel = kind === 'cancel';
        const field = document.getElementById(`${kind}-reason-${orderId}`);
        const reason = field.value.trim();

        if (!reason) {
            confirmSwal.fire({
                icon: 'warning',
                title: 'Reason needed',
                text: `Please tell us why you want to ${isCancel ? 'cancel' : 'return'} this order.`
            });
            return;
        }

        const result = await confirmSwal.fire({
            icon: 'warning',
            title: 'Are you sure?',
            text: isCancel ? 'Do you really want to cancel this order?' : 'Do you really want to return this order?',
            showCancelButton: true,
            confirmButtonText: isCancel ? 'Yes, cancel it' : 'Yes, return it',
            cancelButtonText: isCancel ? 'No, keep it' : 'No, keep it'
        });
        if (!result.isConfirmed) return;

        try {
            const data = await postJson(isCancel ? `/user/ordersCancel/${orderId}` : `/user/ordersReturn/${orderId}`, { reason });
            if (data.success) {
                await confirmSwal.fire({
                    icon: 'success',
                    title: isCancel ? 'Order cancelled' : 'Return requested',
                    text: isCancel ? 'Your order has been cancelled.' : 'Your return request has been submitted.',
                    confirmButtonText: 'OK'
                });
                location.reload();
            } else {
                confirmSwal.fire({
                    icon: 'error',
                    title: 'Something went wrong',
                    text: data.message || 'Please try again.',
                    confirmButtonText: 'OK'
                });
            }
        } catch (err) {
            console.error(err);
            confirmSwal.fire({ icon: 'error', title: 'Something went wrong', text: 'Please try again.', confirmButtonText: 'OK' });
        }
    }

    async function retryPayment(orderId) {
        try {
            const response = await fetch(`/user/order-details/${orderId}`);
            if (!response.ok) throw new Error('Failed to fetch order details');
            const data = await response.json();

            const options = {
                key: 'rzp_test_pXZoNFSmNMsqPv', // Replace with your Razorpay key
                amount: data.amount,
                currency: data.currency,
                name: 'ShoppyCart',
                description: 'Retry order payment',
                order_id: data.orderId,
                handler: async function (response) {
                    try {
                        const verifyResponse = await fetch('/user/verify-razorpay-payment', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                razorpay_order_id: response.razorpay_order_id,
                                razorpay_payment_id: response.razorpay_payment_id,
                                razorpay_signature: response.razorpay_signature
                            })
                        });
                        const verification = await verifyResponse.json();
                        if (verifyResponse.ok) {
                            await confirmSwal.fire({
                                icon: 'success',
                                title: 'Payment successful',
                                text: 'Thank you for your payment.',
                                confirmButtonText: 'OK',
                                timer: 3000,
                                timerProgressBar: true
                            });
                            window.location.reload();
                        } else {
                            console.error('Payment verification failed:', verification);
                            window.location.href = '/failed';
                        }
                    } catch (error) {
                        console.error('Error during payment verification:', error);
                        window.location.href = '/failed';
                    }
                },
                theme: { color: '#151517' }
            };

            const rzp = new Razorpay(options);
            rzp.on('payment.failed', function (response) {
                console.error('Payment failed:', response.error);
                window.location.href = '/failed';
            });
            rzp.open();
        } catch (error) {
            console.error('Error during Razorpay retry:', error);
            window.location.href = '/failed';
        }
    }

    // ---------- Click handling ----------
    document.addEventListener('click', async (e) => {
        const el = e.target.closest('[data-action]');
        if (!el) return;

        switch (el.dataset.action) {
            case 'tab':
                openTab(el.dataset.tab);
                history.replaceState(null, '', '?section=' + el.dataset.tab);
                break;

            case 'toggle': {
                const box = document.getElementById(el.dataset.target);
                if (box) box.hidden = !box.hidden;
                break;
            }

            case 'edit-profile': {
                const form = document.getElementById('editProfileForm');
                const view = document.getElementById('profileView');
                const btn = document.getElementById('editProfileBtn');
                const editing = form.hidden;
                form.hidden = !editing;
                view.hidden = editing;
                btn.hidden = editing;
                break;
            }

            case 'copy-referral':
                try {
                    await navigator.clipboard.writeText(document.getElementById('referralCode').innerText.trim());
                    toast.fire({ icon: 'success', title: 'Referral code copied' });
                } catch (err) {
                    console.error(err);
                    toast.fire({ icon: 'error', title: 'Could not copy the code' });
                }
                break;

            case 'cancel-order': orderAction('cancel', el.dataset.orderId); break;
            case 'return-order': orderAction('return', el.dataset.orderId); break;
            case 'retry-payment': retryPayment(el.dataset.orderId); break;

            case 'open-address':
                document.getElementById('addAddressDialog').showModal();
                break;
            case 'close-address':
                document.getElementById('addAddressDialog').close();
                break;

            case 'delete-address': {
                const result = await confirmSwal.fire({
                    icon: 'warning',
                    title: 'Delete this address?',
                    text: "You won't be able to undo this.",
                    showCancelButton: true,
                    confirmButtonText: 'Yes, delete it',
                    cancelButtonText: 'Keep it'
                });
                if (result.isConfirmed) document.getElementById(el.dataset.form).submit();
                break;
            }
        }
    });

    // Close the dialog when the backdrop is clicked
    const addDialog = document.getElementById('addAddressDialog');
    addDialog.addEventListener('click', (e) => {
        if (e.target === addDialog) addDialog.close();
    });

    // ---------- Initial state from the URL ----------
    document.addEventListener('DOMContentLoaded', () => {
        const params = new URLSearchParams(window.location.search);
        const raw = params.get('section');
        const section = SECTION_ALIASES[raw] || raw || 'profile';
        openTab(section);

        const addressId = params.get('addressId');
        if (addressId) {
            const card = document.getElementById('address-' + addressId);
            if (card) {
                card.classList.add('is-highlight');
                card.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        if (params.get('deleteSuccess') === 'true') {
            toast.fire({ icon: 'success', title: 'Address deleted' });
        }
    });
</script>
</body>
</html>
