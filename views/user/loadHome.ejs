<%- include('./partials/header') %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link rel="stylesheet" href="/stylesheet/home.css">

<%
    // "Deal of the month" ends at the start of next month
    const now = new Date();
    const dealEnd = new Date(now.getFullYear(), now.getMonth() + 1, 1).toISOString();
%>

<!-- Top bar -->
<header class="pl-nav">
    <div class="pl-nav__inner">
        <a class="pl-nav__logo" href="/user/">
            <img src="/image/Shoppycartfinel.png" alt="ShoppyCart">
        </a>

        <ul class="pl-nav__links">
            <li class="is-active"><a href="/user/">Home</a></li>
            <li><a href="/user/productList">Shop</a></li>
        </ul>

        <div class="pl-nav__actions">
            <a href="/user/profile" aria-label="Profile"><i class="fas fa-user"></i></a>
            <a href="/user/wishlist" aria-label="Wishlist"><i class="fas fa-heart"></i></a>
            <a href="/user/cart" aria-label="Cart"><i class="fas fa-shopping-cart"></i></a>
            <a href="/user/wallet" aria-label="Wallet"><i class="fas fa-wallet"></i></a>
            <a href="/user/logout" aria-label="Log out"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </div>
</header>

<main>

    <!-- Hero -->
    <section class="hm-hero" aria-label="Featured collections">
        <div class="hm-slide is-active" style="background-image: url('/banners/mainBanner.png');">
            <div class="hm-slide__inner">
                <div class="hm-hero__text">
                    <h2 class="hm-hero__title">Sports Collection 2026</h2>
                    <p class="hm-hero__copy">Luxury essentials, ethically crafted with an unwavering commitment to exceptional quality.</p>
                    <a href="/user/productList" class="hm-btn hm-btn--light">Shop now</a>
                </div>
            </div>
        </div>

        <div class="hm-slide" style="background-image: url('/banners/banner1.png');">
            <div class="hm-slide__inner">
                <div class="hm-hero__text">
                    <h2 class="hm-hero__title">Running Collection 2026</h2>
                    <p class="hm-hero__copy">Luxury essentials, ethically crafted with an unwavering commitment to exceptional quality.</p>
                    <a href="/user/productList" class="hm-btn hm-btn--light">Shop now</a>
                </div>
            </div>
        </div>

        <div class="hm-dots">
            <button type="button" class="hm-dot is-active" aria-label="Show slide 1" aria-current="true"></button>
            <button type="button" class="hm-dot" aria-label="Show slide 2"></button>
        </div>
    </section>

    <!-- Collections -->
    <section class="hm-section">
        <div class="hm-tiles">
            <a class="hm-tile" href="/user/productList">
                <img src="/banners/1.png" alt="" loading="lazy">
                <div class="hm-tile__text"><h3>Trending</h3><span>Shop now</span></div>
            </a>
            <a class="hm-tile" href="/user/productList">
                <img src="/banners/2.png" alt="" loading="lazy">
                <div class="hm-tile__text"><h3>Sports</h3><span>Shop now</span></div>
            </a>
            <a class="hm-tile" href="/user/productList">
                <img src="/banners/3.png" alt="" loading="lazy">
                <div class="hm-tile__text"><h3>Sneakers</h3><span>Shop now</span></div>
            </a>
        </div>
    </section>

    <!-- Best sellers -->
    <section class="hm-section">
        <div class="hm-head">
            <h2>Best sellers</h2>
            <a class="hm-link" href="/user/productList">View all</a>
        </div>

        <div class="pl-grid">
            <% product.forEach(function (item) {
                const price = item.discountPrice || item.price;
            %>
                <a class="pl-card" href="/user/productDetails/<%= item._id %>">
                    <div class="pl-card__media">
                        <img src="/uploads/<%= item.images[0] %>" alt="<%= item.product %>" loading="lazy">
                    </div>
                    <div class="pl-card__body">
                        <% if (item.categoryId && item.categoryId.name) { %>
                            <p class="pl-card__brand"><%= item.categoryId.name %></p>
                        <% } %>
                        <h3 class="pl-card__name"><%= item.product %></h3>
                        <div class="pl-price">₹<%= price %></div>
                    </div>
                </a>
            <% }); %>
        </div>
    </section>

    <!-- Deal of the month -->
    <section class="hm-section">
        <div class="hm-deal">
            <div class="hm-deal__pic">
                <img src="/banners/banneroffer.png" alt="" loading="lazy">
                <div class="hm-deal__price">
                    <span>Sale price</span>
                    <strong>₹2999</strong>
                </div>
            </div>

            <div class="hm-deal__text">
                <p class="hm-deal__label">Deal of the month</p>
                <h2>Nike Zoom Vomero Roam</h2>

                <div class="hm-timer" id="countdown" data-end="<%= dealEnd %>" role="timer" aria-label="Time left on this deal">
                    <div class="hm-timer__cell"><strong data-unit="days">0</strong><span>Days</span></div>
                    <div class="hm-timer__cell"><strong data-unit="hours">0</strong><span>Hours</span></div>
                    <div class="hm-timer__cell"><strong data-unit="minutes">0</strong><span>Minutes</span></div>
                    <div class="hm-timer__cell"><strong data-unit="seconds">0</strong><span>Seconds</span></div>
                </div>

                <a href="/user/productList" class="hm-btn">Shop now</a>
            </div>
        </div>
    </section>

    <!-- Instagram -->
    <section class="hm-section hm-section--last">
        <div class="hm-insta__head">
            <h2>Instagram</h2>
            <p>New drops, styling ideas and behind the scenes.</p>
            <strong>@shoppycart</strong>
        </div>
        <div class="hm-insta__grid">
            <img src="/banners/ins1.png" alt="" loading="lazy">
            <img src="/banners/ins2.png" alt="" loading="lazy">
            <img src="/banners/ins3.png" alt="" loading="lazy">
            <img src="/banners/ins4.png" alt="" loading="lazy">
            <img src="/banners/ins5.png" alt="" loading="lazy">
            <img src="/banners/ins6.png" alt="" loading="lazy">
        </div>
    </section>

</main>

<%- include('./partials/footer.ejs') %>

<script>
    // Hero slider
    (function () {
        const slides = Array.from(document.querySelectorAll('.hm-slide'));
        const dots = Array.from(document.querySelectorAll('.hm-dot'));
        if (slides.length < 2) return;

        let current = 0;
        let timer;

        function show(n) {
            slides[current].classList.remove('is-active');
            dots[current].classList.remove('is-active');
            dots[current].removeAttribute('aria-current');
            current = (n + slides.length) % slides.length;
            slides[current].classList.add('is-active');
            dots[current].classList.add('is-active');
            dots[current].setAttribute('aria-current', 'true');
        }

        function start() {
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            timer = setInterval(() => show(current + 1), 6000);
        }

        dots.forEach((dot, n) => dot.addEventListener('click', () => {
            clearInterval(timer);
            show(n);
            start();
        }));

        start();
    })();

    // Deal countdown
    (function () {
        const box = document.getElementById('countdown');
        if (!box) return;

        const end = new Date(box.dataset.end).getTime();
        const cells = {};
        box.querySelectorAll('[data-unit]').forEach((el) => { cells[el.dataset.unit] = el; });

        function tick() {
            let s = Math.max(0, Math.floor((end - Date.now()) / 1000));
            const days = Math.floor(s / 86400); s %= 86400;
            const hours = Math.floor(s / 3600); s %= 3600;
            const minutes = Math.floor(s / 60);
            const seconds = s % 60;
            cells.days.textContent = days;
            cells.hours.textContent = String(hours).padStart(2, '0');
            cells.minutes.textContent = String(minutes).padStart(2, '0');
            cells.seconds.textContent = String(seconds).padStart(2, '0');
        }

        tick();
        setInterval(tick, 1000);
    })();
</script>
</body>
</html>
