<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Reset password · ShoppyCart</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap');

        :root {
            --pl-bg: #ffffff;
            --pl-tile: #f4f4f2;
            --pl-ink: #151517;
            --pl-muted: #74777d;
            --pl-line: #e7e7e9;
            --pl-sale: #1f6b45;
            --pl-danger: #c2373d;
            --pl-radius: 6px;
            --pl-font: 'Manrope', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 32px 16px;
            font-family: var(--pl-font);
            color: var(--pl-ink);
            background: var(--pl-tile);
            -webkit-font-smoothing: antialiased;
        }

        .lg-card { width: 100%; max-width: 420px; padding: 40px; background: var(--pl-bg); border-radius: 10px; }
        .lg-logo { display: block; margin-bottom: 32px; }
        .lg-logo img { height: 28px; width: auto; display: block; }
        .lg-title { margin: 0 0 8px; font-size: 28px; font-weight: 600; letter-spacing: -0.02em; }
        .lg-lead { margin: 0 0 28px; font-size: 15px; line-height: 1.6; color: var(--pl-muted); }

        .lg-notice { margin: 0 0 20px; padding: 12px 14px; font-size: 14px; line-height: 1.5; border-radius: var(--pl-radius); }
        .lg-notice--ok { color: var(--pl-sale); background: #e9f3ed; }
        .lg-notice--error { color: var(--pl-danger); background: #fbeaeb; }

        .lg-field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 18px; }
        .lg-field label { font-size: 13px; font-weight: 500; color: var(--pl-muted); }
        .lg-field input {
            height: 48px; padding: 0 14px;
            font: inherit; font-size: 15px; color: var(--pl-ink);
            background: #fff; border: 1px solid var(--pl-line); border-radius: var(--pl-radius);
            transition: border-color .2s;
        }
        .lg-field input:focus { outline: none; border-color: var(--pl-ink); }
        .lg-field input.is-invalid { border-color: var(--pl-danger); }
        .lg-hint { font-size: 13px; color: var(--pl-danger); }

        .lg-btn {
            display: flex; align-items: center; justify-content: center;
            width: 100%; height: 52px; margin-top: 8px; padding: 0 24px;
            font: inherit; font-size: 15px; font-weight: 600;
            color: #fff; background: var(--pl-ink);
            border: 1px solid var(--pl-ink); border-radius: var(--pl-radius);
            cursor: pointer; transition: background .2s;
        }
        .lg-btn:hover { background: #2c2c30; }

        .lg-foot { margin: 24px 0 0; font-size: 14px; text-align: center; }
        .lg-foot a { color: var(--pl-muted); text-underline-offset: 3px; }
        .lg-foot a:hover { color: var(--pl-ink); }

        a:focus-visible, button:focus-visible, input:focus-visible { outline: 2px solid var(--pl-ink); outline-offset: 3px; }

        @media (max-width: 480px) { .lg-card { padding: 28px 20px; } .lg-title { font-size: 24px; } }
        @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
    </style>
</head>
<body>
    <main class="lg-card">
        <a class="lg-logo" href="/user/"><img src="/image/Shoppycartfinel.png" alt="ShoppyCart"></a>

        <h1 class="lg-title">Reset your password</h1>
        <p class="lg-lead">Enter your email and choose a new password.</p>

        <% if (typeof message !== 'undefined' && message) { %>
            <div class="lg-notice lg-notice--ok" role="status"><%= message %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="lg-notice lg-notice--error" role="alert"><%= error %></div>
        <% } %>

        <form action="/user/forgotPassword" method="post" id="resetForm">
            <div class="lg-field">
                <label for="email">Email</label>
                <input name="email" id="email" type="email" autocomplete="email" required>
            </div>
            <div class="lg-field">
                <label for="newpassword">New password</label>
                <input name="password" id="newpassword" type="password" autocomplete="new-password" required>
            </div>
            <div class="lg-field">
                <label for="confirmpassword">Confirm new password</label>
                <input name="cpassword" id="confirmpassword" type="password" autocomplete="new-password" required>
                <span class="lg-hint" id="matchHint" role="alert"></span>
            </div>

            <button type="submit" class="lg-btn">Update password</button>
        </form>

        <p class="lg-foot"><a href="/user/login">Cancel and go back to log in</a></p>
    </main>

    <script>
        const form = document.getElementById('resetForm');
        const pw = document.getElementById('newpassword');
        const cpw = document.getElementById('confirmpassword');
        const hint = document.getElementById('matchHint');

        function checkMatch() {
            const bad = cpw.value && pw.value !== cpw.value;
            cpw.classList.toggle('is-invalid', bad);
            hint.textContent = bad ? 'Passwords do not match.' : '';
            return !bad;
        }
        pw.addEventListener('input', checkMatch);
        cpw.addEventListener('input', checkMatch);
        form.addEventListener('submit', (e) => {
            if (pw.value !== cpw.value) { e.preventDefault(); checkMatch(); cpw.focus(); }
        });
    </script>
</body>
</html>
