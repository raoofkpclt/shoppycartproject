<%- include('partials/header.ejs') %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link rel="stylesheet" href="/stylesheet/cart.css">

<%
    // Edit these to change cart rules
    const MAX_QTY = 6;
    const FREE_SHIPPING_ABOVE = 25;
    const SHIPPING_FEE = 5;

    const list = (typeof items !== 'undefined' && items) ? items : [];
    const money = (n) => '₹' + Number(n || 0).toFixed(2);

    const subtotal = list.reduce((sum, item) => sum + item.price * item.quantity, 0);
    const units = list.reduce((sum, item) => sum + item.quantity, 0);
    const shipping = subtotal > FREE_SHIPPING_ABOVE ? 0 : SHIPPING_FEE;
%>

<!-- Top bar -->
<header class="pl-nav">
    <div class="pl-nav__inner">
        <a class="pl-nav__logo" href="/user/">
            <img src="/image/Shoppycartfinel.png" alt="ShoppyCart">
        </a>

        <ul class="pl-nav__links">
            <li><a href="/user/">Home</a></li>
            <li><a href="/user/productList">Shop</a></li>
        </ul>

        <div class="pl-nav__actions">
            <a href="/user/profile" aria-label="Profile"><i class="fas fa-user"></i></a>
            <a href="/user/wishlist" aria-label="Wishlist"><i class="fas fa-heart"></i></a>
            <a href="/user/cart" class="is-active" aria-label="Cart" aria-current="page"><i class="fas fa-shopping-cart"></i></a>
            <a href="/user/wallet" aria-label="Wallet"><i class="fas fa-wallet"></i></a>
            <a href="/user/logout" aria-label="Log out"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </div>
</header>
<style>
    /* ShoppyCart – Cart (premium / minimal)
   Use as /public/stylesheet/cart.css
   Shares the same tokens as the other redesigned pages */

@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap');

:root {
    --pl-bg: #ffffff;
    --pl-tile: #f4f4f2;
    --pl-ink: #151517;
    --pl-muted: #74777d;
    --pl-line: #e7e7e9;
    --pl-sale: #1f6b45;
    --pl-danger: #c2373d;
    --pl-radius: 6px;
    --pl-font: 'Manrope', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --pl-max: 1240px;
}

body {
    font-family: var(--pl-font);
    color: var(--pl-ink);
    background: var(--pl-bg);
    -webkit-font-smoothing: antialiased;
}

/* ---------- Top bar ---------- */
.pl-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--pl-line);
}
.pl-nav__inner {
    max-width: var(--pl-max);
    margin: 0 auto;
    padding: 0 24px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
}
.pl-nav__logo img { height: 28px; width: auto; display: block; }
.pl-nav__links { display: flex; gap: 32px; list-style: none; margin: 0; padding: 0; }
.pl-nav__links a {
    font-size: 14px;
    font-weight: 500;
    color: var(--pl-muted);
    text-decoration: none;
    padding: 6px 0;
    border-bottom: 1.5px solid transparent;
    transition: color .2s, border-color .2s;
}
.pl-nav__links a:hover { color: var(--pl-ink); }
.pl-nav__actions { display: flex; align-items: center; gap: 6px; }
.pl-nav__actions a {
    width: 40px; height: 40px;
    display: grid; place-items: center;
    border-radius: 50%;
    color: var(--pl-ink);
    font-size: 16px;
    text-decoration: none;
    transition: background .2s;
}
.pl-nav__actions a:hover,
.pl-nav__actions a.is-active { background: var(--pl-tile); }

/* ---------- Page ---------- */
.ct-page {
    max-width: var(--pl-max);
    margin: 0 auto;
    padding: 40px 24px 112px;
}
.ct-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--pl-line);
    margin-bottom: 8px;
}
.ct-title { margin: 0; font-size: 32px; font-weight: 600; letter-spacing: -0.02em; }
.ct-count { font-size: 14px; color: var(--pl-muted); }

.ct-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 64px;
    align-items: start;
}

/* ---------- Items ---------- */
.ct-items { list-style: none; margin: 0; padding: 0; }
.ct-item {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) auto 100px;
    gap: 24px;
    align-items: center;
    padding: 28px 0;
    border-bottom: 1px solid var(--pl-line);
}
.ct-item__pic {
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--pl-radius);
    overflow: hidden;
    background: var(--pl-tile);
}
.ct-item__pic img { width: 100%; height: 100%; object-fit: cover; display: block; }
.ct-item__name { margin: 0 0 4px; font-size: 15px; font-weight: 600; line-height: 1.35; }
.ct-item__price { margin: 0 0 12px; font-size: 14px; color: var(--pl-muted); }
.ct-item__total { font-size: 16px; font-weight: 600; text-align: right; font-variant-numeric: tabular-nums; }

.ct-textbtn {
    padding: 0;
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    color: var(--pl-muted);
    background: none;
    border: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
}
.ct-textbtn:hover { color: var(--pl-danger); }

/* Quantity stepper */
.ct-qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--pl-line);
    border-radius: var(--pl-radius);
    overflow: hidden;
}
.ct-qty button {
    width: 40px; height: 44px;
    display: grid; place-items: center;
    padding: 0;
    font-size: 11px;
    color: var(--pl-ink);
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: background .2s;
}
.ct-qty button:hover:not(:disabled) { background: var(--pl-tile); }
.ct-qty button:disabled { color: #b9bbc0; cursor: not-allowed; }
.ct-qty input {
    width: 40px; height: 44px;
    padding: 0;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    color: var(--pl-ink);
    background: transparent;
    border: 0;
    -moz-appearance: textfield;
}
.ct-qty input::-webkit-outer-spin-button,
.ct-qty input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
.ct-qty input:focus { outline: none; }

.ct-foot { margin-top: 32px; }
.ct-link {
    font-size: 14px;
    color: var(--pl-muted);
    text-decoration: underline;
    text-underline-offset: 4px;
}
.ct-link:hover { color: var(--pl-ink); }

/* ---------- Summary ---------- */
.ct-summary {
    position: sticky;
    top: 92px;
    margin-top: 32px;
    padding: 32px;
    background: var(--pl-tile);
    border-radius: 10px;
}
.ct-summary h2 { margin: 0 0 24px; font-size: 18px; font-weight: 600; }
.ct-sum { margin: 0; }
.ct-sum div { display: flex; justify-content: space-between; gap: 16px; padding: 8px 0; font-size: 15px; }
.ct-sum dt { color: var(--pl-muted); }
.ct-sum dd { margin: 0; font-variant-numeric: tabular-nums; }
.ct-sum .ct-sum__total {
    margin-top: 12px;
    padding-top: 20px;
    border-top: 1px solid #deded9;
    font-size: 18px;
    font-weight: 600;
}
.ct-sum .ct-sum__total dt { color: var(--pl-ink); }
.ct-note { margin: 16px 0 24px; font-size: 13px; line-height: 1.6; color: var(--pl-muted); }

.ct-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    padding: 0 28px;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    color: #fff;
    background: var(--pl-ink);
    border: 1px solid var(--pl-ink);
    border-radius: var(--pl-radius);
    cursor: pointer;
    transition: background .2s, color .2s, border-color .2s;
}
.ct-btn:hover { background: #2c2c30; color: #fff; }
.ct-btn--ghost { background: transparent; color: var(--pl-ink); border-color: var(--pl-line); }
.ct-btn--ghost:hover { background: transparent; color: var(--pl-ink); border-color: var(--pl-ink); }
.ct-summary .ct-btn { width: 100%; }

/* ---------- Empty ---------- */
.ct-empty { padding: 112px 24px; text-align: center; }
.ct-empty h2 { margin: 0 0 8px; font-size: 22px; font-weight: 600; letter-spacing: -0.015em; }
.ct-empty p { margin: 0 0 24px; font-size: 15px; color: var(--pl-muted); }

/* ---------- SweetAlert ---------- */
.ct-swal { font-family: var(--pl-font) !important; border-radius: 10px !important; }
.ct-swal .swal2-title { font-size: 20px; font-weight: 600; color: var(--pl-ink); }
.ct-swal .swal2-html-container { font-size: 15px; color: var(--pl-muted); }
.ct-swal .swal2-actions { gap: 12px; }
.ct-swal .ct-btn { height: 44px; font-size: 14px; }

/* ---------- Focus ---------- */
.ct-page a:focus-visible,
.ct-page button:focus-visible,
.pl-nav a:focus-visible {
    outline: 2px solid var(--pl-ink);
    outline-offset: 3px;
}

/* ---------- Responsive ---------- */
@media (max-width: 1024px) {
    .ct-layout { grid-template-columns: 1fr; gap: 0; }
    .ct-summary { position: static; margin-top: 40px; }
}
@media (max-width: 640px) {
    .pl-nav__links { display: none; }
    .ct-page { padding: 24px 16px 80px; }
    .ct-title { font-size: 26px; }
    .ct-item {
        grid-template-columns: 80px minmax(0, 1fr);
        grid-template-areas:
            'pic info'
            'qty total';
        gap: 16px 16px;
    }
    .ct-item__pic { grid-area: pic; }
    .ct-item__info { grid-area: info; }
    .ct-qty { grid-area: qty; justify-self: start; }
    .ct-item__total { grid-area: total; align-self: center; }
    .ct-summary { padding: 24px; }
}

@media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
}
</style>

<main class="ct-page">
    <div class="ct-head">
        <h1 class="ct-title">Cart</h1>
        <% if (list.length) { %>
            <span class="ct-count" id="cartCount"><%= units %> <%= units === 1 ? 'item' : 'items' %></span>
        <% } %>
    </div>

    <% if (list.length) { %>
    <form action="/user/checkout" method="post" id="checkoutForm">
        <div class="ct-layout">

            <!-- Items -->
            <div>
                <ul class="ct-items">
                    <% list.forEach((item) => { %>
                        <li class="ct-item" id="product-row-<%= item.productId._id %>" data-price="<%= item.price %>">
                            <a class="ct-item__pic" href="/user/productDetails/<%= item.productId._id %>">
                                <img src="/uploads/<%= item.imageUrl %>" alt="<%= item.name %>" loading="lazy">
                            </a>

                            <div class="ct-item__info">
                                <h3 class="ct-item__name"><%= item.name %></h3>
                                <p class="ct-item__price"><%= money(item.price) %></p>
                                <button type="button" class="ct-textbtn" data-remove="<%= item.productId._id %>">Remove</button>
                            </div>

                            <div class="ct-qty">
                                <button type="button" data-qty="decrease" data-product-id="<%= item.productId._id %>" aria-label="Decrease quantity">
                                    <i class="fa fa-minus"></i>
                                </button>
                                <input type="number"
                                       name="quantity[<%= item.productId._id %>]"
                                       id="quantity-<%= item.productId._id %>"
                                       value="<%= item.quantity %>"
                                       aria-label="Quantity"
                                       readonly>
                                <button type="button" data-qty="increase" data-product-id="<%= item.productId._id %>" aria-label="Increase quantity"
                                        <%= item.quantity >= MAX_QTY ? 'disabled' : '' %>>
                                    <i class="fa fa-plus"></i>
                                </button>
                            </div>

                            <div class="ct-item__total"><%= money(item.price * item.quantity) %></div>
                        </li>
                    <% }); %>
                </ul>

                <div class="ct-foot">
                    <a class="ct-link" href="/user/productList">Continue shopping</a>
                </div>
            </div>

            <!-- Summary -->
            <aside class="ct-summary">
                <h2>Order summary</h2>
                <dl class="ct-sum">
                    <div><dt>Subtotal</dt><dd id="subtotal"><%= money(subtotal) %></dd></div>
                    <div><dt>Shipping</dt><dd id="shipping"><%= shipping === 0 ? 'Free' : money(shipping) %></dd></div>
                    <div class="ct-sum__total"><dt>Total</dt><dd id="cartTotal"><%= money(subtotal + shipping) %></dd></div>
                </dl>
                <p class="ct-note">Any available offers are applied at checkout.</p>
                <button type="submit" class="ct-btn">Proceed to checkout</button>
            </aside>
        </div>
    </form>
    <% } else { %>
        <div class="ct-empty">
            <h2>Your cart is empty</h2>
            <p>Browse the shop and add something you like.</p>
            <a href="/user/productList" class="ct-btn">Continue shopping</a>
        </div>
    <% } %>
</main>

<%- include('partials/footer.ejs') %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const MAX_QTY = <%= MAX_QTY %>;
    const FREE_SHIPPING_ABOVE = <%= FREE_SHIPPING_ABOVE %>;
    const SHIPPING_FEE = <%= SHIPPING_FEE %>;

    const confirmSwal = Swal.mixin({
        buttonsStyling: false,
        reverseButtons: true,
        customClass: {
            popup: 'ct-swal',
            confirmButton: 'ct-btn',
            cancelButton: 'ct-btn ct-btn--ghost'
        }
    });
    const toast = Swal.mixin({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 2200,
        timerProgressBar: true,
        customClass: { popup: 'ct-swal' }
    });

    const money = (n) => '₹' + n.toFixed(2);

    // Recalculate line totals and the summary from what is on screen
    function recalc() {
        const rows = document.querySelectorAll('.ct-item');
        if (!rows.length) { window.location.reload(); return; }

        let subtotal = 0;
        let units = 0;
        rows.forEach((row) => {
            const price = parseFloat(row.dataset.price);
            const qty = parseInt(row.querySelector('.ct-qty input').value, 10) || 0;
            row.querySelector('.ct-item__total').textContent = money(price * qty);
            subtotal += price * qty;
            units += qty;
        });

        const shipping = subtotal > FREE_SHIPPING_ABOVE ? 0 : SHIPPING_FEE;
        document.getElementById('subtotal').textContent = money(subtotal);
        document.getElementById('shipping').textContent = shipping === 0 ? 'Free' : money(shipping);
        document.getElementById('cartTotal').textContent = money(subtotal + shipping);
        document.getElementById('cartCount').textContent = units + (units === 1 ? ' item' : ' items');
    }

    // Change quantity
    async function updateQuantity(btn) {
        const productId = btn.dataset.productId;
        const action = btn.dataset.qty;
        const row = document.getElementById(`product-row-${productId}`);
        const buttons = row.querySelectorAll('.ct-qty button');
        buttons.forEach((b) => (b.disabled = true));

        try {
            const response = await fetch(`/user/updateCart/${productId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({ action })
            });
            const data = await response.json();

            if (!data.success) {
                toast.fire({ icon: 'error', title: data.message || 'Could not update the quantity' });
                buttons.forEach((b) => (b.disabled = false));
                // keep "+" disabled if already at the limit
                const input = row.querySelector('.ct-qty input');
                row.querySelector('[data-qty="increase"]').disabled = parseInt(input.value, 10) >= MAX_QTY;
                return;
            }

            if (data.quantity === 0) {
                row.remove();
            } else {
                row.querySelector('.ct-qty input').value = data.quantity;
                buttons.forEach((b) => (b.disabled = false));
                row.querySelector('[data-qty="increase"]').disabled = data.quantity >= MAX_QTY;
                if (data.quantity >= MAX_QTY && action === 'increase') {
                    toast.fire({ icon: 'warning', title: `Limit reached: ${MAX_QTY} per product` });
                }
            }
            recalc();
        } catch (error) {
            console.error(error);
            buttons.forEach((b) => (b.disabled = false));
            toast.fire({ icon: 'error', title: 'Something went wrong' });
        }
    }

    // Remove an item
    async function removeItem(productId) {
        const result = await confirmSwal.fire({
            icon: 'warning',
            title: 'Remove this product?',
            text: 'It will be removed from your cart.',
            showCancelButton: true,
            confirmButtonText: 'Yes, remove it',
            cancelButtonText: 'Keep it'
        });
        if (!result.isConfirmed) return;

        try {
            const response = await fetch('/user/removeCart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({ productId })
            });
            const data = await response.json();

            if (response.ok) {
                document.getElementById(`product-row-${productId}`).remove();
                toast.fire({ icon: 'success', title: data.message || 'Removed from cart' });
                recalc();
            } else {
                toast.fire({ icon: 'error', title: data.message || 'Could not remove the product' });
            }
        } catch (error) {
            console.error('Error removing item:', error);
            toast.fire({ icon: 'error', title: 'Something went wrong' });
        }
    }

    document.addEventListener('click', (e) => {
        const qtyBtn = e.target.closest('[data-qty]');
        if (qtyBtn) { updateQuantity(qtyBtn); return; }

        const removeBtn = e.target.closest('[data-remove]');
        if (removeBtn) removeItem(removeBtn.dataset.remove);
    });
</script>
</body>
</html>
