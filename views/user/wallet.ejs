<%- include('partials/header.ejs') %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link rel="stylesheet" href="/stylesheet/wallet.css">

<%
    const money = (n) => '₹' + Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const fmtDate = (d) => new Date(d).toLocaleString('en-IN', {
        day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit'
    });

    const transactions = (wallet.transactions || [])
        .slice()
        .sort((a, b) => new Date(b.date) - new Date(a.date)); // newest first

    const totalCredit = transactions.filter(t => t.type === 'credit').reduce((sum, t) => sum + Number(t.amount || 0), 0);
    const totalDebit  = transactions.filter(t => t.type !== 'credit').reduce((sum, t) => sum + Number(t.amount || 0), 0);
%>

<!-- Top bar -->
<header class="pl-nav">
    <div class="pl-nav__inner">
        <a class="pl-nav__logo" href="/user/">
            <img src="/image/Shoppycartfinel.png" alt="ShoppyCart">
        </a>

        <ul class="pl-nav__links">
            <li><a href="/user/">Home</a></li>
            <li><a href="/user/productList">Shop</a></li>
        </ul>

        <div class="pl-nav__actions">
            <a href="/user/profile" aria-label="Profile"><i class="fas fa-user"></i></a>
            <a href="/user/wishlist" aria-label="Wishlist"><i class="fas fa-heart"></i></a>
            <a href="/user/cart" aria-label="Cart"><i class="fas fa-shopping-cart"></i></a>
            <a href="/user/wallet" class="is-active" aria-label="Wallet" aria-current="page"><i class="fas fa-wallet"></i></a>
            <a href="/user/logout" aria-label="Log out"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </div>
</header>

<main class="wl-page">
    <h1 class="wl-title">Wallet</h1>

    <section class="wl-balance" aria-label="Current balance">
        <p class="wl-balance__label">Current balance</p>
        <p class="wl-balance__amount"><%= money(wallet.balance) %></p>

        <dl class="wl-stats">
            <div><dt>Total credited</dt><dd><%= money(totalCredit) %></dd></div>
            <div><dt>Total spent</dt><dd><%= money(totalDebit) %></dd></div>
        </dl>
    </section>

    <section class="wl-history">
        <h2>History</h2>

        <% if (transactions.length) { %>
            <ul class="wl-list">
                <% transactions.forEach((t) => {
                    const isCredit = t.type === 'credit';
                %>
                    <li class="wl-row <%= isCredit ? 'is-credit' : 'is-debit' %>">
                        <span class="wl-icon" aria-hidden="true">
                            <i class="fas <%= isCredit ? 'fa-arrow-down' : 'fa-arrow-up' %>"></i>
                        </span>
                        <div>
                            <p class="wl-row__type"><%= isCredit ? 'Credit' : 'Debit' %></p>
                            <p class="wl-row__date"><%= fmtDate(t.date) %></p>
                        </div>
                        <span class="wl-row__amount"><%= isCredit ? '+' : '−' %><%= money(t.amount) %></span>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <div class="wl-empty">
                <h3>No transactions yet</h3>
                <p>Money added to your wallet and anything you spend from it will show up here.</p>
            </div>
        <% } %>
    </section>
</main>

<%- include('partials/footer.ejs') %>
</body>
</html>
