<%- include('partials/header.ejs') %>

<%
    const failedOrderId = (typeof orderId !== 'undefined' && orderId && orderId !== 'undefined') ? orderId : '';
%>

<style>
@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap');

:root {
    --pl-bg: #ffffff;
    --pl-tile: #f4f4f2;
    --pl-ink: #151517;
    --pl-muted: #74777d;
    --pl-line: #e7e7e9;
    --pl-danger: #c2373d;
    --pl-radius: 6px;
    --pl-font: 'Manrope', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --pl-max: 1240px;
}

body { font-family: var(--pl-font); color: var(--pl-ink); background: var(--pl-bg); -webkit-font-smoothing: antialiased; }

/* ---------- Top bar ---------- */
.pl-nav { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--pl-line); }
.pl-nav__inner { max-width: var(--pl-max); margin: 0 auto; padding: 0 24px; height: 68px; display: flex; align-items: center; }
.pl-nav__logo img { height: 28px; width: auto; display: block; }

/* ---------- Failure ---------- */
.of-page { max-width: 560px; margin: 0 auto; padding: 96px 24px 120px; text-align: center; }

.of-mark { width: 72px; height: 72px; margin: 0 auto 32px; color: var(--pl-danger); }
.of-mark circle { fill: none; stroke: currentColor; stroke-width: 2; opacity: .25; }
.of-mark path { fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-dasharray: 26; stroke-dashoffset: 26; animation: of-draw .45s ease-out forwards; }
.of-mark path:nth-of-type(2) { animation-delay: .25s; }
@keyframes of-draw { to { stroke-dashoffset: 0; } }

.of-title { margin: 0 0 12px; font-size: 32px; font-weight: 600; letter-spacing: -0.02em; }
.of-lead { margin: 0 auto 40px; max-width: 420px; font-size: 15px; line-height: 1.65; color: var(--pl-muted); }

.of-card { margin-bottom: 40px; padding: 28px 32px; background: var(--pl-tile); border-radius: 10px; text-align: left; }
.of-card h2 { margin: 0 0 12px; font-size: 16px; font-weight: 600; }
.of-card ul { margin: 0; padding-left: 18px; font-size: 14px; line-height: 1.8; color: var(--pl-muted); }
.of-ref { display: flex; justify-content: space-between; gap: 16px; margin-top: 16px; padding-top: 16px; border-top: 1px solid #deded9; font-size: 14px; }
.of-ref dt { color: var(--pl-muted); }
.of-ref dd { margin: 0; font-weight: 600; word-break: break-all; text-align: right; }

.of-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
.of-btn { display: inline-flex; align-items: center; justify-content: center; height: 52px; padding: 0 28px; font: inherit; font-size: 15px; font-weight: 600; text-decoration: none; color: #fff; background: var(--pl-ink); border: 1px solid var(--pl-ink); border-radius: var(--pl-radius); cursor: pointer; transition: background .2s, border-color .2s; }
.of-btn:hover { background: #2c2c30; color: #fff; }
.of-btn--ghost { background: transparent; color: var(--pl-ink); border-color: var(--pl-line); }
.of-btn--ghost:hover { background: transparent; color: var(--pl-ink); border-color: var(--pl-ink); }

.of-page a:focus-visible, .pl-nav a:focus-visible { outline: 2px solid var(--pl-ink); outline-offset: 3px; }

@media (max-width: 640px) {
    .of-page { padding: 64px 16px 80px; }
    .of-title { font-size: 26px; }
    .of-card { padding: 20px; }
    .of-actions .of-btn { width: 100%; }
}
@media (prefers-reduced-motion: reduce) {
    .of-mark path { animation: none; stroke-dashoffset: 0; }
    * { transition: none !important; }
}
</style>

<header class="pl-nav">
    <div class="pl-nav__inner">
        <a class="pl-nav__logo" href="/user/"><img src="/image/Shoppycartfinel.png" alt="ShoppyCart"></a>
    </div>
</header>

<main class="of-page">
    <svg class="of-mark" viewBox="0 0 72 72" aria-hidden="true">
        <circle cx="36" cy="36" r="34"></circle>
        <path d="M26 26l20 20"></path>
        <path d="M46 26L26 46"></path>
    </svg>

    <h1 class="of-title">Your order didn't go through</h1>
    <p class="of-lead">The payment wasn't completed and your order wasn't placed. Your cart is still saved, so you can try again.</p>

    <div class="of-card">
        <h2>What you can do</h2>
        <ul>
            <li>Check your card, UPI or bank details and try again.</li>
            <li>Choose a different payment method.</li>
            <li>If money was deducted, it is usually refunded automatically within a few days.</li>
        </ul>
        <% if (failedOrderId) { %>
            <dl class="of-ref"><dt>Reference</dt><dd><%= failedOrderId %></dd></dl>
        <% } %>
    </div>

    <div class="of-actions">
        <a href="/user/cart" class="of-btn">Return to cart</a>
        <a href="/user/productList" class="of-btn of-btn--ghost">Continue shopping</a>
    </div>
</main>

<%- include('partials/footer.ejs') %>
</body>
</html>
