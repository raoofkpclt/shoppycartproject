<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shoppycart.admin</title>
    <link rel="stylesheet" href="/stylesheet/adminDash.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css" />
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet"> <!-- For Bootstrap 4 -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Same typeface as the dashboard -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        /* =====================================================
           Admin shell + sidebar (all classes prefixed sb- / admin-)
           ===================================================== */
        :root {
            --sb-ink: #0F1B33;
            --sb-slate: #5B6578;
            --sb-mute: #8A93A5;
            --sb-line: #E3E7EE;
            --sb-mist: #F2F4F7;
            --sb-brass: #B8935A;
            --sb-bar-h: 60px;
        }

        .admin-shell {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background: #F2F4F7;
            font-family: 'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif;
        }

        /* ---------- mobile: sticky top bar + collapsible menu ---------- */
        .sb {
            position: sticky;
            top: 0;
            z-index: 1030;
            background: #fff;
            border-bottom: 1px solid var(--sb-line);
            max-height: 100vh;
            max-height: 100dvh;
            overflow-y: auto;
        }
        .sb-bar {
            display: flex;
            align-items: center;
            gap: 12px;
            height: var(--sb-bar-h);
            padding: 0 14px;
        }
        .sb-toggle {
            width: 40px;
            height: 40px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--sb-line);
            background: #fff;
            border-radius: 10px;
            color: var(--sb-ink);
            font-size: 20px;
            line-height: 1;
            cursor: pointer;
            transition: background-color .15s;
        }
        .sb-toggle:hover { background: var(--sb-mist); }
        .sb-brand { display: inline-flex; align-items: center; }
        .sb-brand img { height: 30px; width: auto; max-width: 100%; display: block; }

        /* smooth open / close without measuring heights */
        .sb-menu {
            display: grid;
            grid-template-rows: 0fr;
            transition: grid-template-rows .25s ease;
        }
        .sb.is-open .sb-menu { grid-template-rows: 1fr; }
        .sb-menu-inner {
            overflow: hidden;
            min-height: 0;
            visibility: hidden;                 /* closed links can't be tabbed to */
            transition: visibility 0s linear .25s;
        }
        .sb.is-open .sb-menu-inner { visibility: visible; transition-delay: 0s; }
        .sb-menu-pad { padding: 4px 14px 16px; display: flex; flex-direction: column; }

        /* ---------- links ---------- */
        .sb-list {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .sb-link {
            position: relative;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 12px;
            border-radius: 10px;
            color: var(--sb-slate);
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            transition: background-color .15s, color .15s;
        }
        .sb-link i { font-size: 18px; line-height: 1; width: 20px; text-align: center; flex-shrink: 0; }
        .sb-link:hover { background: var(--sb-mist); color: var(--sb-ink); text-decoration: none; }
        .sb-link:focus-visible,
        .sb-toggle:focus-visible,
        .sb-brand:focus-visible { outline: 2px solid var(--sb-brass); outline-offset: 2px; }

        .sb-link.is-active { background: var(--sb-mist); color: var(--sb-ink); }
        .sb-link.is-active i { color: var(--sb-brass); }
        .sb-link.is-active::before {
            content: "";
            position: absolute;
            left: 0;
            top: 50%;
            width: 3px;
            height: 18px;
            transform: translateY(-50%);
            border-radius: 0 3px 3px 0;
            background: var(--sb-brass);
        }

        .sb-foot {
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px solid var(--sb-line);
        }
        .sb-link.is-danger:hover { background: #FFF1EF; color: #B3261E; }

        /* ---------- desktop: fixed-width sidebar ---------- */
        @media (min-width: 992px) {
            .admin-shell { flex-direction: row; align-items: flex-start; }

            .sb {
                flex: 0 0 248px;
                width: 248px;
                height: 100vh;
                height: 100dvh;
                max-height: none;
                display: flex;
                flex-direction: column;
                overflow: visible;
                border-bottom: 0;
                border-right: 1px solid var(--sb-line);
            }
            .sb-bar { height: auto; padding: 26px 22px 22px; }
            .sb-toggle { display: none; }

            .sb-menu { display: block; flex: 1; min-height: 0; transition: none; }
            .sb-menu-inner { height: 100%; overflow-y: auto; visibility: visible; }
            .sb-menu-pad { height: 100%; padding: 0 14px 18px; }
            .sb-foot { margin-top: auto; }

            /* the page content fills the space next to the sidebar */
            .admin-shell > :not(.sb) { flex: 1 1 0; min-width: 0; }
        }

        /* ---------- mobile: let the whole page scroll under the sticky bar ---------- */
        @media (max-width: 991.98px) {
            .admin-shell > .vh-100 { height: auto !important; min-height: calc(100vh - var(--sb-bar-h)); }
            .admin-shell > .vh-100 > .overflow-auto { overflow: visible !important; }
        }

        @media (prefers-reduced-motion: reduce) {
            .sb-menu, .sb-menu-inner, .sb-link, .sb-toggle { transition: none; }
        }
    </style>
</head>
<body>

<!-- Dashboard shell (the page content that follows sits next to the sidebar) -->
<div class="admin-shell">
    <!-- Sidebar (desktop) / top bar + menu (mobile) -->
    <nav class="sb" id="navbarVertical" aria-label="Main navigation">
        <div class="sb-bar">
            <!-- Menu button (mobile only) -->
            <button class="sb-toggle" id="sbToggle" type="button" aria-expanded="false" aria-controls="sbMenu" aria-label="Open menu">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>
            <!-- Brand -->
            <a class="sb-brand" href="dash" aria-label="Shoppycart dashboard">
                <img src="/image/Shoppycartfinel.png" alt="Shoppycart">
            </a>
        </div>

        <div class="sb-menu" id="sbMenu">
            <div class="sb-menu-inner">
                <div class="sb-menu-pad">
                    <!-- Navigation -->
                    <ul class="sb-list">
                        <li><a class="sb-link" data-slug="dash" href="dash"><i class="bi bi-house-door" aria-hidden="true"></i><span>Dashboard</span></a></li>
                        <li><a class="sb-link" data-slug="orderManagement" href="orderManagement"><i class="bi bi-receipt" aria-hidden="true"></i><span>Orders</span></a></li>
                        <li><a class="sb-link" data-slug="categoryManagement" href="categoryManagement"><i class="bi bi-tags" aria-hidden="true"></i><span>Category</span></a></li>
                        <li><a class="sb-link" data-slug="productManagement" href="productManagement"><i class="bi bi-bag-check" aria-hidden="true"></i><span>Products</span></a></li>
                        <li><a class="sb-link" data-slug="userManagement" href="userManagement"><i class="bi bi-people-fill" aria-hidden="true"></i><span>Users</span></a></li>
                        <li><a class="sb-link" data-slug="couponManagement" href="couponManagement"><i class="bi bi-ticket-perforated" aria-hidden="true"></i><span>Coupons</span></a></li>
                        <li><a class="sb-link" data-slug="offerManagement" href="offerManagement"><i class="bi bi-gift" aria-hidden="true"></i><span>Offers</span></a></li>
                        <li><a class="sb-link" data-slug="salesReport" href="salesReport"><i class="bi bi-bar-chart" aria-hidden="true"></i><span>Report</span></a></li>
                    </ul>

                    <!-- Account -->
                    <ul class="sb-list sb-foot">
                        <li><a class="sb-link is-danger" href="/admin/logout"><i class="bi bi-box-arrow-right" aria-hidden="true"></i><span>Logout</span></a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <script>
        (function () {
            var nav = document.getElementById('navbarVertical');
            var btn = document.getElementById('sbToggle');
            if (!nav || !btn) return;
            var icon = btn.querySelector('i');

            /* open / close the mobile menu */
            function setOpen(open) {
                nav.classList.toggle('is-open', open);
                btn.setAttribute('aria-expanded', open ? 'true' : 'false');
                btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
                icon.className = open ? 'bi bi-x-lg' : 'bi bi-list';
            }
            btn.addEventListener('click', function () {
                setOpen(!nav.classList.contains('is-open'));
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') setOpen(false);
            });
            window.addEventListener('resize', function () {
                if (window.innerWidth >= 992) setOpen(false);
            });

            /* highlight the current page (matches any segment of the URL, e.g. /admin/orderManagement/12) */
            var segments = location.pathname.split('/').filter(Boolean);
            var links = nav.querySelectorAll('.sb-link[data-slug]');
            var matched = false;
            links.forEach(function (a) {
                if (segments.indexOf(a.getAttribute('data-slug')) !== -1) {
                    a.classList.add('is-active');
                    a.setAttribute('aria-current', 'page');
                    matched = true;
                }
            });
            // /admin on its own is the dashboard
            if (!matched && segments.length <= 1) {
                var home = nav.querySelector('.sb-link[data-slug="dash"]');
                if (home) {
                    home.classList.add('is-active');
                    home.setAttribute('aria-current', 'page');
                }
            }
        })();
    </script>
