<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login</title>

    <!-- Same typefaces as the other admin pages -->
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet">

    <style>
        :root {
            --ink: #0F1B33;
            --ink-2: #2A3F6B;
            --line: #E3E7EE;
            --slate: #5B6578;
            --mute: #8A93A5;
            --brass: #B8935A;
        }
        * { box-sizing: border-box; }
        html, body { margin: 0; min-height: 100%; }

        body {
            font-family: 'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif;
            font-size: 15px;
            line-height: 1.5;
            color: var(--ink);
            background: #F2F4F8;
            -webkit-font-smoothing: antialiased;
        }

        .login {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            min-height: 100vh;
        }

        /* ---------- left: brand panel ---------- */
        .login-aside {
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 56px;
            background: var(--ink);
            background-image: radial-gradient(700px 360px at 90% -10%, rgba(184, 147, 90, .22), transparent 70%);
            color: #fff;
        }
        .login-aside h2 {
            margin: 0;
            max-width: 420px;
            font-family: 'Newsreader', Georgia, serif;
            font-weight: 500;
            font-size: clamp(2.2rem, 3.6vw, 3.1rem);
            line-height: 1.08;
            letter-spacing: -0.02em;
        }
        .login-aside .rule {
            width: 120px;
            margin: 26px 0 22px;
            border: 0;
            border-top: 2px dashed var(--brass);
        }
        .login-aside p { margin: 0; max-width: 380px; color: #AEB8CE; }

        /* ---------- right: form ---------- */
        .login-main {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 24px;
        }
        .login-form { width: 100%; max-width: 400px; }
        .login-form h1 {
            margin: 0;
            font-family: 'Newsreader', Georgia, serif;
            font-weight: 500;
            font-size: 2.25rem;
            line-height: 1.05;
            letter-spacing: -0.015em;
        }
        .login-form .sub { margin: 8px 0 28px; color: var(--slate); }

        .notice {
            margin-bottom: 18px;
            padding: 12px 16px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 600;
        }
        .notice.ok  { background: #E8F6EE; border: 1px solid #BFE3CF; color: #146C43; }
        .notice.bad { background: #FDECEA; border: 1px solid #F3C9C2; color: #A32A1F; }

        .fld { margin-bottom: 18px; }
        .fld label {
            display: block;
            margin-bottom: 6px;
            font-size: 13px;
            font-weight: 600;
            color: var(--slate);
        }
        .inp {
            width: 100%;
            padding: 12px 14px;
            font: inherit;
            font-size: 15px;
            color: var(--ink);
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 10px;
            transition: border-color .15s;
        }
        .inp:hover { border-color: #C9D0DC; }
        .inp:focus { outline: 2px solid var(--brass); outline-offset: 1px; border-color: transparent; }

        .pw { position: relative; }
        .pw .inp { padding-right: 68px; }
        .pw-toggle {
            appearance: none;
            position: absolute;
            top: 50%;
            right: 8px;
            transform: translateY(-50%);
            padding: 6px 10px;
            border: 0;
            border-radius: 8px;
            background: none;
            color: var(--slate);
            font: inherit;
            font-size: 12.5px;
            font-weight: 700;
            cursor: pointer;
        }
        .pw-toggle:hover { background: #F2F4F7; color: var(--ink); }
        .pw-toggle:focus-visible { outline: 2px solid var(--brass); outline-offset: 1px; }

        .cb {
            appearance: none;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            margin-top: 8px;
            padding: 13px 18px;
            font: inherit;
            font-weight: 700;
            font-size: 14px;
            color: #fff;
            background: var(--ink);
            border: 1px solid var(--ink);
            border-radius: 10px;
            cursor: pointer;
            transition: background-color .15s, border-color .15s;
        }
        .cb:hover:not([disabled]) { background: var(--ink-2); border-color: var(--ink-2); }
        .cb:focus-visible { outline: 2px solid var(--brass); outline-offset: 2px; }
        .cb[disabled] { opacity: .6; cursor: not-allowed; }

        /* ---------- small screens: form only ---------- */
        @media (max-width: 899.98px) {
            .login { grid-template-columns: 1fr; }
            .login-aside { display: none; }
            .login-main { min-height: 100vh; align-items: flex-start; padding-top: 12vh; }
            .login-form h1 { font-size: 2rem; }
            .inp { font-size: 16px; }              /* 16px stops iOS zooming into fields */
        }
        @media (prefers-reduced-motion: reduce) {
            .inp, .cb { transition: none; }
        }
    </style>
</head>

<body>
    <%
        const flashMessage = locals.message || '';
        const flashError = locals.error || '';
    %>
    <div class="login">

        <aside class="login-aside" aria-hidden="true">
            <h2>Run your store from one place.</h2>
            <hr class="rule">
            <p>Manage products, orders, coupons, offers and customers, and download sales reports.</p>
        </aside>

        <main class="login-main">
            <form class="login-form" action="/admin/login" method="post" id="loginForm">
                <h1>Admin login</h1>
                <p class="sub">Log in with your admin account.</p>

                <% if (flashMessage) { %><div class="notice ok" role="status"><%= flashMessage %></div><% } %>
                <% if (flashError) { %><div class="notice bad" role="alert"><%= flashError %></div><% } %>

                <div class="fld">
                    <label for="email">Email</label>
                    <input type="text" class="inp" id="email" name="email" inputmode="email" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus required>
                </div>

                <div class="fld">
                    <label for="password">Password</label>
                    <div class="pw">
                        <input type="password" class="inp" id="password" name="password" autocomplete="current-password" required>
                        <button type="button" class="pw-toggle" id="pwToggle" aria-controls="password" aria-pressed="false">Show</button>
                    </div>
                </div>

                <button type="submit" class="cb" id="submitBtn">Log in</button>
            </form>
        </main>

    </div>

    <script>
        (function () {
            var form = document.getElementById('loginForm');
            var pw = document.getElementById('password');
            var toggle = document.getElementById('pwToggle');
            var submitBtn = document.getElementById('submitBtn');

            toggle.addEventListener('click', function () {
                var show = pw.type === 'password';
                pw.type = show ? 'text' : 'password';
                toggle.textContent = show ? 'Hide' : 'Show';
                toggle.setAttribute('aria-pressed', show ? 'true' : 'false');
            });

            form.addEventListener('submit', function () {
                submitBtn.disabled = true;           // no double submits
                submitBtn.textContent = 'Logging in…';
            });
        })();
    </script>
</body>
</html>
